<themes:CfSidePanelWindow x:Class="CloudFlow.App.Views.RuleEditorDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:themes="clr-namespace:CloudFlow.App.Themes"
 Title="编辑网络规则" Width="460" Height="680" SizeToContent="Manual" ResizeMode="NoResize" WindowStyle="None" ShowInTaskbar="False"
 WindowStartupLocation="Manual" Background="{DynamicResource Cf.DialogBackgroundBrush}"
 FontSize="13" UseLayoutRounding="True" TextElement.Foreground="{DynamicResource Cf.TextPrimaryBrush}">
 <Border Background="{DynamicResource Cf.DialogBackgroundBrush}" BorderBrush="{DynamicResource Cf.BorderBrush}" BorderThickness="1">
 <Grid Margin="24">
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <DockPanel Grid.Row="0" Margin="0,0,0,24">
  <Button x:Name="HeaderCloseButton" DockPanel.Dock="Right" Content="×" Click="Close_Click" Style="{StaticResource Cf.IconButton}" ToolTip="关闭编辑面板"/>
  <TextBlock Text="编辑网络规则" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
 </DockPanel>
 <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
 <StackPanel>

  <TextBlock x:Name="RuleTitle" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" TextWrapping="Wrap"/>
  <Border Background="{DynamicResource Cf.PageBackgroundBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,20"><TextBlock x:Name="ContextText" Style="{StaticResource Cf.Muted}" TextWrapping="Wrap"/></Border>
  <StackPanel x:Name="Inputs">
   <TextBlock Text="修改字段" Style="{StaticResource Cf.Muted}"/>
   <ComboBox Background="{DynamicResource Cf.PageBackgroundBrush}" Foreground="{DynamicResource Cf.TextPrimaryBrush}" BorderBrush="{DynamicResource Cf.BorderBrush}" x:Name="FieldBox" SelectedIndex="0" SelectionChanged="Field_Changed" Margin="0,5,0,16">
    <ComboBoxItem Content="目标端口"/><ComboBoxItem Content="优先级"/>
   </ComboBox>
   <TextBlock x:Name="CurrentText" Style="{StaticResource Cf.Muted}" Margin="0,0,0,6"/>
   <TextBox Background="{DynamicResource Cf.PageBackgroundBrush}" Foreground="{DynamicResource Cf.TextPrimaryBrush}" BorderBrush="{DynamicResource Cf.BorderBrush}" x:Name="ValueBox" Padding="8,6"/>
   <TextBlock x:Name="HintText" Style="{StaticResource Cf.Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
  </StackPanel>
  <TextBlock x:Name="Feedback" TextWrapping="Wrap" Margin="0,18,0,0"/>
  <ProgressBar x:Name="Progress" IsIndeterminate="True" Height="3" Visibility="Collapsed" Margin="0,12,0,0"/>
  </StackPanel>
 </ScrollViewer>
 <Border Grid.Row="2" BorderBrush="{DynamicResource Cf.BorderBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,16,0,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
   <Button x:Name="BackButton" Content="返回修改" Click="Back_Click" Visibility="Collapsed" Style="{StaticResource Cf.SecondaryButton}" Margin="0,0,10,0"/>
   <Button x:Name="CloseButton" Content="取消" Click="Close_Click" Style="{StaticResource Cf.SecondaryButton}"/>
   <Button x:Name="SubmitButton" Content="提交变更" Click="Submit_Click" IsDefault="True" Style="{StaticResource Cf.PrimaryButton}" Margin="10,0,0,0"/>
  </StackPanel></Border>
 </Grid>
 </Border>
</themes:CfSidePanelWindow>
