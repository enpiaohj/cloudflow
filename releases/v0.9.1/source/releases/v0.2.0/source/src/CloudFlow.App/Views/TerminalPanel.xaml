<UserControl x:Class="CloudFlow.App.Views.TerminalPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">

    <!-- ===================== 底部终端面板（VS Code 风格） =====================
         收起即整体 Collapsed：底部不留任何残留，回入口是顶栏那个终端按钮。
         DataContext 由 MainWindow 设为 ShellViewModel.Terminal。

         高度由 Border 上的 Height="{Binding PanelHeight}" 唯一决定（含标签条，
         见 TerminalPanelViewModel.PanelHeight 的注释），抓手只改 PanelHeight，
         不存在"行定义与绑定互相覆盖"的双写者问题（那是 GridSplitter 的坑，见抓手处注释）。 -->
    <Border Height="{Binding PanelHeight}"
            Background="{DynamicResource Cf.PageBackgroundBrush}"
            BorderBrush="{DynamicResource Cf.BorderBrush}"
            BorderThickness="0,1,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ===================== 会话标签条 =====================
                 常规下铺满整条；全屏时收成一条居中的胶囊（参考 RemoteFlow 的全屏药丸工具条）。
                 全屏期间顶栏与左导航都隐藏了，这条胶囊是切会话、退全屏的唯一入口，
                 所以它必须始终可见 —— 不做"自动隐藏 + 顶沿唤出"那套（见文件末尾注释）。 -->
            <Border Grid.Row="0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFullScreen}" Value="True">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                                <Setter Property="Margin" Value="8,4" />
                                <Setter Property="Padding" Value="6,0" />
                                <Setter Property="CornerRadius" Value="18" />
                                <Setter Property="Background" Value="{DynamicResource Cf.TopBarBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource Cf.BorderBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                <!-- 标签多了横向滚动而不是换行：这一条的高度必须恒定，否则面板会随标签数变高 -->
                <ScrollViewer Grid.Column="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <ListBox Background="Transparent" BorderThickness="0" Padding="6,0,0,0"
                             ItemsSource="{Binding Tabs}"
                             SelectedItem="{Binding ActiveTab, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource Cf.SectionTab}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ui:SymbolIcon Grid.Column="0" Symbol="WindowConsole20" FontSize="15"
                                                   VerticalAlignment="Center" />

                                    <TextBlock Grid.Column="1" Text="{Binding VmName}" FontSize="12.5"
                                               Margin="8,0,0,0" VerticalAlignment="Center" />

                                    <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="11.5"
                                               Margin="8,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Cf.TextMutedBrush}"
                                               ToolTip="{Binding StatusTip}" />

                                    <!-- 关闭：RelativeSource 走本 UserControl 的 DataContext（面板 VM），
                                         不是标签自身 —— 标签 VM 上没有关闭命令 -->
                                    <Button Grid.Column="3" Style="{StaticResource Cf.TopBarButton}"
                                            Width="20" Height="20" Padding="0" Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            ToolTip="关闭该会话"
                                            Command="{Binding DataContext.CloseTabCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <ui:SymbolIcon Symbol="Dismiss20" FontSize="12"
                                                       Foreground="{DynamicResource Cf.TextMutedBrush}" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 最大化 / 还原：同一个按钮，图标与提示随 IsMaximized 互换。
                         两个 SymbolIcon 同格叠放、可见性相反 —— 比给按钮换 Icon 少一个转换器。 -->
                    <Button Style="{StaticResource Cf.TopBarButton}"
                            Width="28" Height="28" Padding="0" Margin="4,0,0,0"
                            ToolTip="{Binding MaximizeTip}"
                            Command="{Binding ToggleMaximizeCommand}">
                        <Grid>
                            <ui:SymbolIcon Symbol="ArrowMaximize20" FontSize="14"
                                           Foreground="{DynamicResource Cf.TextSecondaryBrush}"
                                           Visibility="{Binding IsMaximized,
                                                       Converter={StaticResource InverseBoolToVisibility}}" />
                            <ui:SymbolIcon Symbol="ArrowMinimize20" FontSize="14"
                                           Foreground="{DynamicResource Cf.TextSecondaryBrush}"
                                           Visibility="{Binding IsMaximized,
                                                       Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </Button>

                    <!-- 全屏 / 退出：面板连同顶栏与左导航一起让位，铺满整个窗口 -->
                    <Button Style="{StaticResource Cf.TopBarButton}"
                            Width="28" Height="28" Padding="0" Margin="4,0,0,0"
                            ToolTip="{Binding FullScreenTip}"
                            Command="{Binding ToggleFullScreenCommand}">
                        <Grid>
                            <ui:SymbolIcon Symbol="FullScreenMaximize20" FontSize="14"
                                           Foreground="{DynamicResource Cf.TextSecondaryBrush}"
                                           Visibility="{Binding IsFullScreen,
                                                       Converter={StaticResource InverseBoolToVisibility}}" />
                            <ui:SymbolIcon Symbol="FullScreenMinimize20" FontSize="14"
                                           Foreground="{DynamicResource Cf.TextSecondaryBrush}"
                                           Visibility="{Binding IsFullScreen,
                                                       Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource Cf.TopBarButton}"
                            Width="28" Height="28" Padding="0" Margin="4,0,6,0"
                            ToolTip="收起终端面板"
                            Command="{Binding ToggleExpandedCommand}">
                        <ui:SymbolIcon Symbol="ChevronDown20" FontSize="15"
                                       Foreground="{DynamicResource Cf.TextSecondaryBrush}" />
                    </Button>
                </StackPanel>
                </Grid>
            </Border>

            <!-- ===================== 终端内容区 =====================
                 高度 = 面板总高 − 标签条，由上面的 Border 约束出来（* 行）。
                 终端控件由代码后置按需创建并加到这里，多个标签的控件同格叠放、
                 全部存活，只靠 Visibility 切换 —— 切回来时滚动历史还在
                 （历史在 xterm.js 里，不在 WPF 这一侧）。 -->
            <Grid x:Name="TerminalHostArea" Grid.Row="1" />
        </Grid>
    </Border>

    <!--
      为什么没有照搬 RemoteFlow 那套「自动隐藏 + 顶沿唤出 + 可拖动 + 固定」：

      1) 它的胶囊用 Popup（独立顶层窗口）承载，是为了浮在 RDP 的 ActiveX 画面之上 ——
         普通 WPF 浮层会被 airspace 盖住，而且收不到其上的鼠标事件。CloudFlow 的胶囊
         停靠在自己那一行里、与 WebView2 不重叠，没有这个问题，所以既不需要 Popup，
         也不需要为它写光标轮询与鼠标钩子。
      2) 它的胶囊会盖住画面，才有「藏起来把空间还给画面」的必要；这条停靠条不占终端
         的空间，自动隐藏只会让唯一的会话切换入口变得难以发现。

      若以后要让它真正浮在终端之上（例如全屏时也隐藏、只在顶沿唤出），**必须改用 Popup**，
      否则会被 WebView2 的 HWND 盖住，做出来是个点不动的浮层。
    -->
</UserControl>
