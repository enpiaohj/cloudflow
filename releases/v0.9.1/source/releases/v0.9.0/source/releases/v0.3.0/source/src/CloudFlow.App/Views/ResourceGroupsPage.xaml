<UserControl x:Class="CloudFlow.App.Views.ResourceGroupsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:CloudFlow.App.Controls"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">

    <UserControl.Resources>
        <!-- 删除资源组的破坏面比删单台虚拟机更大——不能是一个悬在行上、一碰就着的红按钮，
             必须先点开"⋯"这一步额外的、有意的动作，才能看到"删除资源组"。 -->
        <ContextMenu x:Key="Cf.ResourceGroupRowMenu" x:Shared="False">
            <MenuItem Header="删除资源组" Click="MenuDelete_Click" />
        </ContextMenu>
    </UserControl.Resources>

    <Grid Margin="28,22,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== 面包屑 + 标题 ===== -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="资源" Style="{StaticResource Cf.BreadcrumbText}" />
                    <TextBlock Text="  ›  " Style="{StaticResource Cf.BreadcrumbText}" />
                    <TextBlock Text="资源组" Style="{StaticResource Cf.BreadcrumbCurrent}" />
                </StackPanel>
                <TextBlock Text="资源组" Style="{StaticResource Cf.PageTitle}" />
                <TextBlock Text="按资源组查看当前 Scope 内的资源，整组清理不再使用的环境。"
                           Style="{StaticResource Cf.Subtitle}" Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource Cf.IconButton}" VerticalAlignment="Bottom"
                    Command="{Binding RefreshCommand}"
                    ToolTip="重新查询资源组列表"
                    automation:AutomationProperties.Name="刷新">
                <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="15" />
            </Button>
        </Grid>

        <!-- ===== 操作反馈 InfoBar ===== -->
        <Border Grid.Row="1" Style="{StaticResource Cf.InfoBar}" Margin="0,14,0,0"
                Background="{Binding InfoSeverity, Converter={StaticResource StatusBg}}"
                Visibility="{Binding InfoText, Converter={StaticResource NonEmptyToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Grid.Column="0" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"
                               Symbol="{Binding InfoSeverity, Converter={StaticResource SeverityIcon}}"
                               Foreground="{Binding InfoSeverity, Converter={StaticResource StatusFg}}" />
                <TextBlock Grid.Column="1" Text="{Binding InfoText}" FontSize="12.5" VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{Binding InfoSeverity, Converter={StaticResource StatusFg}}" />
                <Button Grid.Column="2" Style="{StaticResource Cf.IconButton}" Padding="4" Width="24" Height="24"
                        Command="{Binding DismissInfoCommand}" ToolTip="关闭"
                        automation:AutomationProperties.Name="关闭这条提示">
                    <ui:SymbolIcon Symbol="Dismiss16" FontSize="12" />
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Cf.Card}" Padding="6,4,6,6" Margin="0,16,0,0">
            <Grid>
                <DataGrid x:Name="ResourceGroupsGrid"
                          ItemsSource="{Binding Rows}"
                          Style="{StaticResource Cf.DataGrid}"
                          HorizontalScrollBarVisibility="Auto"
                          Visibility="{Binding HasRows, Converter={StaticResource BoolToVisibility}}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="名称" Width="1.2*" MinWidth="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="26" Height="26" CornerRadius="7" Margin="0,0,10,0"
                                                Background="{DynamicResource Cf.Status.Info.Bg}">
                                            <ui:SymbolIcon Symbol="Folder24" FontSize="14"
                                                           Foreground="{DynamicResource Cf.PrimaryBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Name}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="区域" Width="0.8*" MinWidth="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Location, Converter={StaticResource RegionName}}"
                                               FontSize="12.5" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Location}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!-- 订阅显示名称；原来整列都是同一串 GUID，读不出是哪个订阅，GUID 留在 ToolTip -->
                        <DataGridTemplateColumn Header="订阅" Width="1.2*" MinWidth="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SubscriptionName}" FontSize="12.5" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding SubscriptionId}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="资源数" Width="90" MinWidth="90" CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ResourceCountText}" FontSize="12.5" VerticalAlignment="Center"
                                               ToolTip="组内资源数（删除资源组会一并删除这些资源）" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="40" MinWidth="40" CanUserResize="False"
                                                CellStyle="{StaticResource Cf.GridCellCompact}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Cf.TopBarButton}"
                                            Width="26" Height="26" Padding="0"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            IsEnabled="{Binding CanDelete}"
                                            ToolTip="更多操作" automation:AutomationProperties.Name="更多操作"
                                            Tag="{Binding}" Click="RowMenu_Click">
                                        <ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="15" />
                                        <Button.ContextMenu>
                                            <StaticResource ResourceKey="Cf.ResourceGroupRowMenu" />
                                        </Button.ContextMenu>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <controls:EmptyState Margin="0,24" Symbol="Folder24" Title="没有资源组"
                                     Description="{Binding EmptyText}">
                    <controls:EmptyState.Style>
                        <Style TargetType="controls:EmptyState">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasRows}" Value="False" />
                                        <Condition Binding="{Binding IsLoading}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </controls:EmptyState.Style>
                </controls:EmptyState>

                <Border Background="{DynamicResource Cf.LoadingScrimBrush}" CornerRadius="10"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Margin="24,18" VerticalAlignment="Center">
                        <Rectangle Style="{StaticResource Cf.SkeletonBar}" Width="420" />
                        <Rectangle Style="{StaticResource Cf.SkeletonBar}" Width="360" Margin="0,10,0,0" />
                        <Rectangle Style="{StaticResource Cf.SkeletonBar}" Width="300" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3" Text="{Binding SummaryText}" Style="{StaticResource Cf.Muted}" Margin="4,12,0,0"
                   Visibility="{Binding HasRows, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</UserControl>
