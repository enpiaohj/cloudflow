<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:cvc="clr-namespace:CloudFlow.App.Converters"
                    xmlns:behaviors="clr-namespace:CloudFlow.App.Behaviors"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:compute="clr-namespace:CloudFlow.Modules.Compute.Models;assembly=CloudFlow.Modules.Compute">

    <!--
      CloudFlow 样式与模板。配色与样式取自 docs/01-产品设计/UI/UI概念图*.png
      （浅色 Fluent、蓝色主色、白卡片、圆角、细边框）。

      **这里不再定义任何颜色**：所有 Cf.* 画刷都在 Themes/CfPalette.Light.xaml
      （App.xaml 合并的那份，也是运行时实例的持有者），切主题由 CfThemeManager 就地改色。
      本文件只留样式 / 模板 / 转换器，因此不需要重建字典就能换肤。
    -->

    <!-- ===== 转换器 ===== -->
    <cvc:CfStatusBrushConverter x:Key="StatusBg" Mode="Background" />
    <cvc:CfStatusBrushConverter x:Key="StatusFg" Mode="Foreground" />
    <cvc:CfStatusTextConverter x:Key="StatusText" />
    <cvc:CfNullableTextConverter x:Key="NullableText" />
    <cvc:CfResourceNameConverter x:Key="ResourceName" />
    <cvc:CfBoolToVisibilityConverter x:Key="BoolToVisibility" />
    <cvc:CfInverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
    <cvc:CfNonEmptyToVisibilityConverter x:Key="NonEmptyToVisibility" />
    <cvc:CfNullToVisibilityConverter x:Key="NullToVisibility" />
    <cvc:CfNotRunningToVisibilityConverter x:Key="NotRunningToVisibility" />
    <cvc:CfSectionVisibilityConverter x:Key="SectionVisible" />

    <!-- ===== 字体 ===== -->
    <!--
      Segoe UI Variable 是 Windows 11 原生字体族（Settings / File Explorer / Widgets 都在用），
      字重过渡更细腻、数字更紧凑，比经典 Segoe UI 更"现代应用"。Windows 10 上没有这款字体时
      WPF 会自动回退到列表里的下一项，不会出现缺字方块——纯粹的渐进增强，没有兼容性代价。
      Display 变体的字面尺寸是为大号标题优化的（比 Text 变体在大字号下更疏朗），只给 PageTitle 用。
    -->
    <FontFamily x:Key="Cf.FontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Cf.FontFamily.Display">Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI</FontFamily>

    <!-- 全应用默认字体：一处设置，靠 FontFamily 的继承性覆盖所有子元素（Window 与
         CfDialogWindow 都是普通 Window，隐式样式按运行时类型逐级向上找，两边都吃得到）。 -->
    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="{StaticResource Cf.FontFamily}" />
    </Style>

    <!-- ===== 阴影（分层立体感） =====
         只用在"浮在页面之上"的表面（卡片 / 弹层 / 对话框），不用在按钮等内联控件上——
         2024 年后的专业工具类软件（Linear / Vercel / Raycast）普遍是"平面按钮 + 分层卡片"的组合，
         到处加阴影反而显得廉价。数值刻意很轻（Opacity ≤ 0.10）：够分层，不够"浮夸"。 -->
    <DropShadowEffect x:Key="Cf.Elevation.Card" Color="#1B1F2A" Direction="270"
                       BlurRadius="24" ShadowDepth="1.5" Opacity="0.06" RenderingBias="Quality" />
    <DropShadowEffect x:Key="Cf.Elevation.CardHover" Color="#1B1F2A" Direction="270"
                       BlurRadius="30" ShadowDepth="4" Opacity="0.10" RenderingBias="Quality" />
    <DropShadowEffect x:Key="Cf.Elevation.Bar" Color="#1B1F2A" Direction="270"
                       BlurRadius="16" ShadowDepth="2" Opacity="0.05" RenderingBias="Quality" />
    <DropShadowEffect x:Key="Cf.Elevation.Popup" Color="#1B1F2A" Direction="270"
                       BlurRadius="28" ShadowDepth="6" Opacity="0.14" RenderingBias="Quality" />
    <DropShadowEffect x:Key="Cf.Elevation.Dialog" Color="#10131C" Direction="270"
                       BlurRadius="44" ShadowDepth="12" Opacity="0.22" RenderingBias="Quality" />

    <!-- ===== 卡片 ===== -->
    <Style x:Key="Cf.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Cf.CardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Cf.BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Effect" Value="{StaticResource Cf.Elevation.Card}" />
    </Style>

    <!-- 可交互卡片（首页统计卡等）：悬停时阴影加深、边框转向主色一角，给出"这里能点"的反馈。 -->
    <Style x:Key="Cf.InteractiveCard" TargetType="Border" BasedOn="{StaticResource Cf.Card}">
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Effect" Value="{StaticResource Cf.Elevation.CardHover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Cf.PrimaryBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== 文本 =====
         尺寸整体比原来收紧一档（26→24，Subtitle/Muted 加一点行高）：更大的字号不等于更有
         "产品感"，专业工具软件的标题通常比想象中克制，靠字重和留白建立层级，而不是字号本身。 -->
    <Style x:Key="Cf.PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Cf.FontFamily.Display}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Cf.TextPrimaryBrush}" />
    </Style>

    <Style x:Key="Cf.SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Cf.TextPrimaryBrush}" />
    </Style>

    <Style x:Key="Cf.Subtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Cf.TextSecondaryBrush}" />
        <Setter Property="LineHeight" Value="19" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    </Style>

    <Style x:Key="Cf.Muted" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Cf.TextMutedBrush}" />
    </Style>

    <Style x:Key="Cf.StatNumber" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Cf.FontFamily.Display}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Cf.TextPrimaryBrush}" />
    </Style>

    <!-- 统计卡数字下方的短标签（如"虚拟机"/"运行中"）。比 Cf.SectionTitle 小一号、
         比 Cf.Muted 重一号，四张首页统计卡曾各自内联同一组 Setter，这里收成一份共享样式。 -->
    <Style x:Key="Cf.StatLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Cf.TextPrimaryBrush}" />
    </Style>

    <!-- ===== 状态徽章 ===== -->
    <Style x:Key="Cf.Badge" TargetType="Border">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{Binding Mode=OneWay, Converter={StaticResource StatusBg}}" />
    </Style>

    <Style x:Key="Cf.BadgeText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{Binding Mode=OneWay, Converter={StaticResource StatusFg}}" />
    </Style>

    <!-- ===== 规则药丸（概念图 2：Allow 绿 / Deny 红；来源 NIC 蓝 / Subnet 紫） ===== -->
    <Style x:Key="Cf.RulePill" TargetType="Border">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource Cf.Surface.SuccessBrush}" />
    </Style>

    <!-- ===== 图标圆底（统计卡） ===== -->
    <Style x:Key="Cf.IconCircle" TargetType="Border">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="CornerRadius" Value="19" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- ===== 按钮 =====
         圆角从 6 提到 8（与卡片的 12 保持同一套"越大的面越圆"的比例关系），
         按下态额外压一档不透明度——之前只有悬停和禁用两种反馈，点下去和悬停在视觉上
         没有任何区别，专业软件的按钮通常都有这一下"按实了"的反馈。 -->
    <Style x:Key="Cf.PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Cf.PrimaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Cf.OnPrimaryTextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Cf.PrimaryHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Cf.SecondaryButton" TargetType="Button" BasedOn="{StaticResource Cf.PrimaryButton}">
        <Setter Property="Background" Value="{DynamicResource Cf.CardBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Cf.TextPrimaryBrush}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8"
                            BorderBrush="{DynamicResource Cf.BorderBrush}" BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Cf.RowHoverBrush}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Cf.TextMutedBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.75" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 纯图标按钮（刷新等）。固定方形而不是沿用文字按钮内边距：图标没有文字基线，
         按文字按钮的内边距会得到一个偏扁的框，和旁边的方形按钮对不齐。 -->
    <Style x:Key="Cf.IconButton" TargetType="Button" BasedOn="{StaticResource Cf.SecondaryButton}">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="Cf.DangerButton" TargetType="Button" BasedOn="{StaticResource Cf.PrimaryButton}">
        <Setter Property="Background" Value="{DynamicResource Cf.DangerBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Cf.DangerHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 顶栏按钮（无底色，悬停淡底） ===== -->
    <Style x:Key="Cf.TopBarButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Cf.TextPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Cf.RowHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.7" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 账户菜单行（整行可点，悬停高亮） ===== -->
    <Style x:Key="Cf.MenuRow" TargetType="Button" BasedOn="{StaticResource Cf.TopBarButton}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <!-- ===== 面包屑返回链接 =====
         用 Button 而不是带 MouseBinding 的 TextBlock：TextBlock.InputBindings 的鼠标手势
         实测点不动（不可聚焦元素上不触发命令），换成 Button 后才能稳定返回上一级，
         同时获得键盘可达性与 UIA InvokePattern。 -->
    <Style x:Key="Cf.BreadcrumbLink" TargetType="Button" BasedOn="{StaticResource Cf.TopBarButton}">
        <Setter Property="Foreground" Value="{DynamicResource Cf.TextMutedBrush}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="2,1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Cf.RowHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource Cf.PrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 文字链接（"查看全部"这类次要跳转） =====
         之前这类按钮各页面各写一份裸 Button（Transparent 背景、无悬停反馈），
         点上去和普通文字没有区别。收成一份共享样式，悬停有底色反馈。 -->
    <Style x:Key="Cf.LinkButton" TargetType="Button" BasedOn="{StaticResource Cf.TopBarButton}">
        <Setter Property="Foreground" Value="{DynamicResource Cf.PrimaryBrush}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <!-- ===== 提示条图标 / 分页高亮 ===== -->
    <cvc:CfSeverityIconConverter x:Key="SeverityIcon" />
    <cvc:CfEqualsMultiConverter x:Key="EqualsMulti" />
    <cvc:CfRegionNameConverter x:Key="RegionName" />

    <!-- ===== 次级危险动作（如详情页的"关机"） =====
         描边按钮 + 危险色文字，悬停才铺浅红底。实心红块只留给确认框里的最终"删除 / 确认"——
         工具栏里放一块实心红，视觉权重压过了真正的主操作"连接"，整行像在报警。 -->
    <Style x:Key="Cf.DangerSubtleButton" TargetType="Button" BasedOn="{StaticResource Cf.SecondaryButton}">
        <Setter Property="Foreground" Value="{DynamicResource Cf.ErrorTextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8"
                            BorderBrush="{DynamicResource Cf.BorderBrush}" BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Cf.Surface.DangerBrush}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Cf.Surface.DangerBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 复制按钮 =====
         原来是一个写着 "⧉" 字符的透明按钮：这个字符不在界面字体里，渲染成系统回退字体里的一个
         小方框，大小、基线都和旁边的文字对不上。图标画在模板里而不是 Content 里，
         调用方只写 Command / ToolTip 即可。 -->
    <Style x:Key="Cf.CopyButton" TargetType="Button">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                        <ui:SymbolIcon x:Name="glyph" Symbol="Copy16" FontSize="13"
                                       Foreground="{DynamicResource Cf.TextMutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Cf.RowHoverBrush}" />
                            <Setter TargetName="glyph" Property="Foreground" Value="{DynamicResource Cf.PrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 页头 ===== -->
    <Style x:Key="Cf.BreadcrumbText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource Cf.TextMutedBrush}" />
    </Style>

    <Style x:Key="Cf.BreadcrumbCurrent" TargetType="TextBlock" BasedOn="{StaticResource Cf.BreadcrumbText}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Cf.PrimaryBrush}" />
    </Style>

    <!-- 列表页搜索框外壳（ui:TextBox 本身不带与卡片一致的描边与圆角） -->
    <Style x:Key="Cf.SearchField" TargetType="Border">
        <Setter Property="Height" Value="34" />
        <Setter Property="Background" Value="{DynamicResource Cf.CardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Cf.BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <!-- 页面级操作反馈横幅的外壳（背景由各页按严重程度绑定） -->
    <Style x:Key="Cf.InfoBar" TargetType="Border">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <!-- 首页指标卡的标签（数字上方的一行小字） -->
    <Style x:Key="Cf.KpiLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Cf.TextSecondaryBrush}" />
    </Style>

    <!-- 骨架屏占位条：呼吸动画，比"加载中…"文字更有位置感；取 BorderBrush 深浅主题自适应。
         原来只在虚拟机列表页内联定义，资源页也要用，提到这里共享。 -->
    <Style x:Key="Cf.SkeletonBar" TargetType="Rectangle">
        <Setter Property="Height" Value="12" />
        <Setter Property="RadiusX" Value="6" />
        <Setter Property="RadiusY" Value="6" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Fill" Value="{DynamicResource Cf.BorderBrush}" />
        <Setter Property="Opacity" Value="0.6" />
        <Style.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="0.3" To="1" Duration="0:0:0.8" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <!-- ===== 导航 ===== -->
    <!--
      右键菜单 / ToolTip 的隐式主题化。这三类都是 Popup 型表面，默认用 WPF 系统色
      （白底黑字）—— 深色模式下弹出来就是一块刺眼的白色，字还是黑的。
      它们不在窗口逻辑树里渲染，但资源查找能落到 Application.Resources，
      所以 DynamicResource 在这里有效；调色板切换时自动跟随。

      MenuItem 原来只设前景与悬停底色、不重写模板，理由是"系统高亮蓝在深浅两档下都可读"——
      这个判断只顾到了整行的高亮色，漏了默认模板里独立的一块：左侧图标/勾选占位列有自己的
      背景，跟整行高亮背景是两回事，默认模板里这块是固定的浅色系统色，不会跟着我们的深色
      调色板走。真实反馈：深色模式下右键菜单左边一条竖着的白条，紧挨着深色背景上的浅色
      文字，看起来完全没套上主题。这个应用里的 MenuItem 全部是纯文字（不用 Icon、不可勾选、
      没有子菜单），干脆整个重写模板，不留这个用不到的占位列。

      修完 MenuItem 之后同一条白条依旧在——说明真正的占位列其实在 ContextMenu 自己的默认
      模板里（经典 Aero2 主题给整个菜单预留的一条贯穿全高的图标背景带，用来对齐所有菜单项
      的图标，跟每一项各自的 MenuItem 模板是两回事），只改 MenuItem 盖不掉它，这里一并
      重写 ContextMenu 的模板，不再用系统默认的 Popup 外壳。
    -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource Cf.CardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Cf.BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Cf.TextPrimaryBrush}" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8" Padding="{TemplateBinding Padding}"
                            Effect="{StaticResource Cf.Elevation.Popup}">
                        <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource Cf.TextPrimaryBrush}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Margin="2,1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- IsHighlighted 而不是 IsMouseOver：键盘方向键在菜单里移动时也要能看到
                             高亮在哪一项，只认鼠标悬停会导致键盘操作时"选中了但看不出来"。 -->
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Cf.RowHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Cf.TextMutedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Separator 的默认模板同样是"两条线"的立体凹槽效果（一条深线 + 一条浅色高光线），
         深色模式下那条浅色高光线也会露白，跟 MenuItem 是同一类问题，一并处理。 -->
    <Style TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource Cf.BorderBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{TemplateBinding Background}" Margin="6,4" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource Cf.CardBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Cf.TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Cf.BorderBrush}" />
    </Style>

    <Style x:Key="Cf.NavItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Cf.TextSecondaryBrush}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="10,1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="12,9">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Cf.RowHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Cf.RowSelectedBrush}" />
                        </Trigger>
                        <!--
                          分隔条（IsSeparator）也是 NavItems 里的一项，走同一个 ItemContainerStyle。
                          不特殊处理的话它就是一个**完整的空导航行**：占满一行高度、能悬停高亮、能点选，
                          看起来像"菜单项没加载出来"而不是一条分隔线。
                          这里把它压成 1px 线本身的高度并关掉命中测试（点不到 = 选不中）。
                          这条触发器刻意放在最后：同集合里后写的触发器优先，
                          否则 IsMouseOver / IsSelected 会把它盖回去。
                        -->
                        <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                            <Setter Property="IsHitTestVisible" Value="False" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter TargetName="bd" Property="Padding" Value="0" />
                            <Setter TargetName="bd" Property="Background" Value="Transparent" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!--
              分组折叠时，子项只在 DataTemplate 内部把内容 Grid 收起来（见 MainWindow.xaml），
              但这个 ListBoxItem 容器本身（连同模板里 12,9 的 Border Padding）还在占位——
              折叠的子项越多，行间就会多出一截看起来"什么都没有"的空白。
              这里直接把整个容器收起来，折叠状态下不占任何高度。
            -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsChild}" Value="True" />
                    <Condition Binding="{Binding Parent.IsExpanded}" Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Collapsed" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!--
      顶部横向分节条：选中项用一条主色指示条 + 主色文字表示"当前在哪一节"。
      刻意不套 Cf.NavItem：侧栏那套是"垂直导航"语义（整行高亮、图标在左），
      套到顶部会让每个分节看起来像一个按钮，分不清"能点的入口"与"正在看的分节"。
      指示条留 1px 下边距，压在 ListBox 自己的分隔线之上，形成"轨道 + 高亮段"。
    -->
    <Style x:Key="Cf.SectionTab" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Cf.TextSecondaryBrush}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,2,1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="2" />
                        </Grid.RowDefinitions>
                        <Border x:Name="bd" Grid.Row="0" Background="Transparent"
                                CornerRadius="8,8,0,0" Padding="12,7">
                            <ContentPresenter />
                        </Border>
                        <Border x:Name="bar" Grid.Row="1" Background="Transparent" CornerRadius="1" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Cf.RowHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Cf.PrimaryBrush}" />
                            <Setter TargetName="bar" Property="Background" Value="{DynamicResource Cf.PrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== DataGrid ===== -->
    <Style x:Key="Cf.GridColumnHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource Cf.CardBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Cf.TextSecondaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="{DynamicResource Cf.BorderBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Cf.GridRow" TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="{DynamicResource Cf.RowSeparatorBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Cf.RowHoverBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Cf.RowSelectedBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Cf.GridCell" TargetType="DataGridCell">
        <!-- Foreground 必须样式级显式给：非选中的 cell 内容默认落 SystemColors 黑，
             深色模式下就是"规则名/磁盘名黑字看不清"（之前只修了选中态触发器）。 -->
        <Setter Property="Foreground" Value="{DynamicResource Cf.TextPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                            TextElement.Foreground="{TemplateBinding Foreground}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 紧凑单元格：列较多时给内容让出宽度（必须在 Cf.GridCell 之后定义） -->
    <Style x:Key="Cf.GridCellCompact" TargetType="DataGridCell" BasedOn="{StaticResource Cf.GridCell}">
        <Setter Property="Padding" Value="6,0" />
    </Style>

    <!-- 持续旋转的小图标，配合 IsLoadingXxx 的 Visibility 绑定用作轻量加载指示（不做整屏遮罩，
         详情页的几个 Tab 是并行独立加载的，遮罩会互相打架）。RenderTransform 是 Freezable，
         WPF 会给每个应用了该样式的实例各自克隆一份，互不干扰地独立旋转。 -->
    <Style x:Key="Cf.SpinningIcon" TargetType="ui:SymbolIcon">
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <RotateTransform Angle="0" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
                                         From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Cf.DataGrid" TargetType="DataGrid">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="RowHeight" Value="46" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserSortColumns" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource Cf.GridColumnHeader}" />
        <Setter Property="RowStyle" Value="{StaticResource Cf.GridRow}" />
        <Setter Property="CellStyle" Value="{StaticResource Cf.GridCell}" />
        <!-- 关掉自身竖向滚动条（VerticalScrollBarVisibility="Disabled"）交由外层 ScrollViewer
             滚动的表格，鼠标停在表格上滚轮却不生效——DataGrid 内建的 ScrollViewer 仍会吞掉滚轮事件。
             这条把滚轮转发给外层 ScrollViewer，只在确实禁用了自身滚动条时生效。 -->
        <Setter Property="behaviors:ScrollWheelBehavior.BubbleWhenDisabled" Value="True" />
    </Style>

    <!--
      虚拟机操作系统图标。显示器与底座为两者共用，屏幕内容按操作系统区分：
      Windows 显示四格窗格，Linux 显示终端提示符 —— 避免「Linux 虚拟机却显示 Windows 标志」。
      DataContext 为 VmSummary。
    -->
    <DataTemplate x:Key="Cf.VmOsIcon">
        <Viewbox Width="18" Height="18">
            <Grid Width="16" Height="15">
                <!-- 底座 -->
                <Rectangle Width="2.6" Height="2.6" Fill="{DynamicResource Cf.OsIconStandBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,9.6,0,0" />
                <Rectangle Width="7" Height="1.5" RadiusX="0.75" RadiusY="0.75"
                           Fill="{DynamicResource Cf.OsIconStandBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12.6,0,0" />
                <!-- 屏幕 -->
                <Rectangle Width="16" Height="10.6" RadiusX="1.6" RadiusY="1.6"
                           Fill="{DynamicResource Cf.OsIconScreenBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Top" />

                <!-- Windows：四格窗格 -->
                <Canvas x:Name="WindowsMark" Width="7" Height="7"
                        HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0">
                    <Rectangle Canvas.Left="0" Canvas.Top="0" Width="3" Height="3"
                               Fill="{DynamicResource Cf.OsIconMarkBrush}" />
                    <Rectangle Canvas.Left="4" Canvas.Top="0" Width="3" Height="3"
                               Fill="{DynamicResource Cf.OsIconMarkBrush}" />
                    <Rectangle Canvas.Left="0" Canvas.Top="4" Width="3" Height="3"
                               Fill="{DynamicResource Cf.OsIconMarkBrush}" />
                    <Rectangle Canvas.Left="4" Canvas.Top="4" Width="3" Height="3"
                               Fill="{DynamicResource Cf.OsIconMarkBrush}" />
                </Canvas>

                <!-- Linux：终端提示符 >_ -->
                <Canvas x:Name="LinuxMark" Width="8" Height="5.6"
                        HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2.6,0,0">
                    <Path Data="M0.7,0.7 L3.2,2.8 L0.7,4.9"
                          Stroke="{DynamicResource Cf.OsIconMarkBrush}" StrokeThickness="1.4"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    <Rectangle Canvas.Left="4.4" Canvas.Top="4" Width="3.2" Height="1.4"
                               RadiusX="0.4" RadiusY="0.4" Fill="{DynamicResource Cf.OsIconMarkBrush}" />
                </Canvas>
            </Grid>
        </Viewbox>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding OsType}" Value="{x:Static compute:VmOsType.Linux}">
                <Setter TargetName="WindowsMark" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding OsType}" Value="{x:Static compute:VmOsType.Windows}">
                <Setter TargetName="LinuxMark" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

</ResourceDictionary>
