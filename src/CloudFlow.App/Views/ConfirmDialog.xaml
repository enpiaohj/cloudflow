<themes:CfDialogWindow x:Class="CloudFlow.App.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:themes="clr-namespace:CloudFlow.App.Themes"
        Title="{Binding DialogTitle}"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        Background="{DynamicResource Cf.DialogBackgroundBrush}"
        TextElement.Foreground="{DynamicResource Cf.TextPrimaryBrush}">
    <!--
      统一的二次确认对话框：取代散落各处的 MessageBox.Show（原生英文 OK/Cancel/Yes/No
      按钮与应用其余全中文自定义对话框观感不一致）。破坏性/需要用户明确决定的操作
      一律走这里，取消按钮固定样式与语义，确认按钮文案由调用方给出（不是笼统的“确定”）。
    -->
    <StackPanel Margin="28,24">

        <TextBlock Text="{Binding DialogTitle}" FontFamily="{DynamicResource Cf.FontFamily.Display}"
                   FontSize="18" FontWeight="SemiBold"
                   Foreground="{DynamicResource Cf.TextPrimaryBrush}" />
        <TextBlock Text="{Binding Message}" FontSize="13"
                   Foreground="{DynamicResource Cf.TextSecondaryBrush}"
                   Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="19" LineStackingStrategy="BlockLineHeight" />

        <!-- 按钮 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,4">
            <Button Content="取消" Style="{StaticResource Cf.SecondaryButton}" IsCancel="True"
                    Click="Cancel_Click" />
            <Button Content="{Binding ConfirmButtonText}" Style="{StaticResource Cf.PrimaryButton}"
                    Margin="10,0,0,0" Click="Confirm_Click"
                    IsDefault="{Binding IsPrimary}"
                    Visibility="{Binding IsPrimary, Converter={StaticResource BoolToVisibility}}" />
            <Button Content="{Binding ConfirmButtonText}" Style="{StaticResource Cf.DangerButton}"
                    Margin="10,0,0,0" Click="Confirm_Click"
                    IsDefault="{Binding IsDanger}"
                    Visibility="{Binding IsDanger, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </StackPanel>
</themes:CfDialogWindow>
