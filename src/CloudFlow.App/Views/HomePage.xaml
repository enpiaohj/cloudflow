<UserControl x:Class="CloudFlow.App.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
        <StackPanel Margin="28,22,28,24" MaxWidth="1200" HorizontalAlignment="Left">

            <!-- ===== 页头 ===== -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="首页" Style="{StaticResource Cf.PageTitle}" />
                    <TextBlock Text="欢迎回来。以下是你 Azure 环境的当前概况。"
                               Style="{StaticResource Cf.Subtitle}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"
                            HorizontalAlignment="Right">
                    <!-- 首页整页的统计都来自 Azure，读完之后没有任何自动回读的入口，
                         用户想再看一眼就只能切走再切回来。只放图标：这个动作不需要标签，
                         标签只会把它和右边的日期挤在一起。 -->
                    <Button Style="{StaticResource Cf.IconButton}" Margin="0,0,14,0"
                            Command="{Binding RefreshCommand}"
                            ToolTip="重新读取 Azure 环境的当前概况"
                            automation:AutomationProperties.Name="刷新">
                        <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="15" />
                    </Button>
                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding TodayText}" Style="{StaticResource Cf.Subtitle}" />
                        <TextBlock Text="{Binding ScopeSubtitle}" Style="{StaticResource Cf.Muted}"
                                   HorizontalAlignment="Right" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- ===== 统计卡 ===== -->
            <!-- WrapPanel 替代 UniformGrid：窄窗口下 4 张卡自动折成 2×2（每卡固定 250 宽） -->
            <WrapPanel Margin="0,20,0,0">

                <Border Style="{StaticResource Cf.Card}" Width="250" Margin="0,0,14,0">
                    <StackPanel>
                        <Border Style="{StaticResource Cf.IconCircle}" Background="{DynamicResource Cf.Status.Info.Bg}">
                            <!-- 概念图 1：虚拟机统计卡用主机图标（原先误用了云图标，与「计算」导航重复） -->
                            <ui:SymbolIcon Symbol="Desktop24" FontSize="19"
                                           Foreground="{DynamicResource Cf.PrimaryBrush}" />
                        </Border>
                        <TextBlock Text="{Binding TotalVms}" Style="{StaticResource Cf.StatNumber}" Margin="0,12,0,0" />
                        <TextBlock Text="虚拟机" Style="{StaticResource Cf.StatLabel}"
                                   Margin="0,2,0,0" />
                        <TextBlock Text="{Binding TotalVmsDeltaText}" Style="{StaticResource Cf.Muted}"
                                   Foreground="{DynamicResource Cf.SuccessTextBrush}" Margin="0,3,0,0"
                                   Visibility="{Binding TotalVmsDeltaText, Converter={StaticResource NonEmptyToVisibility}}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Cf.Card}" Width="250" Margin="0,0,14,0">
                    <StackPanel>
                        <Border Style="{StaticResource Cf.IconCircle}" Background="{DynamicResource Cf.Status.Success.Bg}">
                            <ui:SymbolIcon Symbol="Play24" FontSize="19" Foreground="{DynamicResource Cf.SuccessTextBrush}" />
                        </Border>
                        <TextBlock Text="{Binding RunningVms}" Style="{StaticResource Cf.StatNumber}" Margin="0,12,0,0" />
                        <TextBlock Text="运行中" Style="{StaticResource Cf.StatLabel}"
                                   Margin="0,2,0,0" />
                        <TextBlock Text="{Binding RunningPercent}" Style="{StaticResource Cf.Muted}" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Cf.Card}" Width="250" Margin="0,0,14,0">
                    <StackPanel>
                        <Border Style="{StaticResource Cf.IconCircle}" Background="{DynamicResource Cf.Status.Neutral.Bg}">
                            <ui:SymbolIcon Symbol="DismissCircle24" FontSize="19"
                                           Foreground="{DynamicResource Cf.TextSecondaryBrush}" />
                        </Border>
                        <TextBlock Text="{Binding DeallocatedVms}" Style="{StaticResource Cf.StatNumber}" Margin="0,12,0,0" />
                        <TextBlock Text="已解除分配" Style="{StaticResource Cf.StatLabel}"
                                   Margin="0,2,0,0" />
                        <TextBlock Text="{Binding DeallocatedPercent}" Style="{StaticResource Cf.Muted}" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Cf.Card}" Width="250">
                    <StackPanel>
                        <Border Style="{StaticResource Cf.IconCircle}" Background="{DynamicResource Cf.Status.Warning.Bg}">
                            <ui:SymbolIcon Symbol="Warning24" FontSize="19" Foreground="{DynamicResource Cf.WarningTextBrush}" />
                        </Border>
                        <TextBlock Text="{Binding NeedAttention}" Style="{StaticResource Cf.StatNumber}" Margin="0,12,0,0" />
                        <TextBlock Text="需要关注" Style="{StaticResource Cf.StatLabel}"
                                   Margin="0,2,0,0" />
                        <!-- 副标题原来写死"1 台意外停机"；改为按真实注意项数量显示，无异常时用弱化色 -->
                        <TextBlock Text="{Binding AttentionSummary}" Margin="0,3,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Cf.Muted}">
                                    <Setter Property="Foreground" Value="{DynamicResource Cf.TextMutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasAttentionItems}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Cf.ErrorTextBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- ===== Recent Operations + Attention Items ===== -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="11*" />
                    <ColumnDefinition Width="9*" />
                </Grid.ColumnDefinitions>

                <!-- Recent Operations -->
                <Border Grid.Column="0" Style="{StaticResource Cf.Card}" Margin="0,0,14,0">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="最近操作" Style="{StaticResource Cf.SectionTitle}" />
                            <Button Grid.Column="1" Content="查看全部" Command="{Binding ViewAllJobsCommand}"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    Foreground="{DynamicResource Cf.PrimaryBrush}" FontSize="12.5" />
                        </Grid>
                        <!-- 真实账户下没有写操作记录时给出说明，否则空表会被误读为加载失败 -->
                        <TextBlock Text="{Binding RecentOperationsEmptyText}" Style="{StaticResource Cf.Muted}"
                                   TextWrapping="Wrap" Margin="0,4,0,0"
                                   Visibility="{Binding HasRecentOperations, Converter={StaticResource InverseBoolToVisibility}}" />
                        <DataGrid ItemsSource="{Binding RecentOperations}" Style="{StaticResource Cf.DataGrid}"
                                  RowHeight="36"
                                  Visibility="{Binding HasRecentOperations, Converter={StaticResource BoolToVisibility}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="时间" Binding="{Binding CreatedAt, StringFormat=HH:mm}"
                                                    CanUserResize="False" />
                                <DataGridTextColumn Header="操作" Binding="{Binding Display}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="ToolTip" Value="{Binding Display}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <!-- 概念图 1：显示资源名（WEB01），完整 Resource ID 会被截断且不可读 -->
                                <DataGridTextColumn Header="资源"
                                                    Binding="{Binding ResourceId, Converter={StaticResource ResourceName}}"
                                                    Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="12.5" />
                                            <Setter Property="ToolTip" Value="{Binding ResourceId}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="状态" Width="100" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Cf.Badge}" DataContext="{Binding Status}">
                                                <TextBlock Text="{Binding Converter={StaticResource StatusText}}"
                                                           Style="{StaticResource Cf.BadgeText}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!-- Attention Items -->
                <Border Grid.Column="1" Style="{StaticResource Cf.Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="注意项" Style="{StaticResource Cf.SectionTitle}"
                                   Margin="0,0,0,10" />
                        <TextBlock Text="{Binding AttentionEmptyText}" Style="{StaticResource Cf.Muted}"
                                   TextWrapping="Wrap" Margin="0,4,0,0"
                                   Visibility="{Binding HasAttentionItems, Converter={StaticResource InverseBoolToVisibility}}" />
                        <ScrollViewer VerticalScrollBarVisibility="Disabled"
                                      Visibility="{Binding HasAttentionItems, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl ItemsSource="{Binding AttentionItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- 无关联 VM 的条目（如汇总类）不可点击：手型光标 + 主色标题
                                             会让用户以为能点进去，点了却没有反应 -->
                                        <Grid Margin="0,7" MouseLeftButtonDown="AttentionItem_Click">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Cursor" Value="Hand" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding VmName}" Value="{x:Null}">
                                                            <Setter Property="Cursor" Value="Arrow" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0" VerticalAlignment="Top">
                                                <ui:SymbolIcon FontSize="17">
                                                    <ui:SymbolIcon.Style>
                                                        <Style TargetType="ui:SymbolIcon">
                                                            <Setter Property="Symbol" Value="Info24" />
                                                            <Setter Property="Foreground" Value="{DynamicResource Cf.PrimaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Severity}" Value="Error">
                                                                    <Setter Property="Symbol" Value="ErrorCircle24" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource Cf.ErrorTextBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                                    <Setter Property="Symbol" Value="Warning24" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource Cf.WarningTextBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ui:SymbolIcon.Style>
                                                </ui:SymbolIcon>
                                            </Grid>
                                            <StackPanel Grid.Column="1" Margin="10,0,8,0">
                                                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource Cf.PrimaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding VmName}" Value="{x:Null}">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Cf.TextPrimaryBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Description}" FontSize="12"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource Cf.TextSecondaryBrush}" Margin="0,1,0,0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Age}" Style="{StaticResource Cf.Muted}"
                                                       VerticalAlignment="Top" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ===== Cost Insight + Quick Actions ===== -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1.6*" />
                </Grid.ColumnDefinitions>

                <!-- Cost Insight（设计文档 §40；正式 Cost 模块在 P3） -->
                <Border Grid.Column="0" Style="{StaticResource Cf.Card}" Margin="0,0,14,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="DataUsage24" FontSize="16"
                                           Foreground="{DynamicResource Cf.PrimaryBrush}" />
                            <TextBlock Grid.Column="1" Text="成本洞察" Style="{StaticResource Cf.SectionTitle}"
                                       Margin="8,0,0,0" />
                        </Grid>
                        <TextBlock Text="{Binding CostAmount}" FontSize="24" FontWeight="Bold"
                                   Foreground="{DynamicResource Cf.TextPrimaryBrush}" />
                        <TextBlock Text="{Binding CostSubtitle}" Style="{StaticResource Cf.Muted}"
                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                        <!-- 绿色徽章只在确有成本数据时出现；"尚未接入"这类说明用中性色，绿色会被读成正面结论 -->
                        <Border CornerRadius="999" Padding="10,3"
                                HorizontalAlignment="Left" Margin="0,10,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource Cf.Status.Neutral.Bg}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasCostData}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Cf.Status.Success.Bg}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding CostDelta}" FontSize="11.5" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Cf.TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasCostData}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Cf.SuccessTextBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Quick Actions -->
                <Border Grid.Column="1" Style="{StaticResource Cf.Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="Flash24" FontSize="16"
                                           Foreground="{DynamicResource Cf.PrimaryBrush}" />
                            <TextBlock Grid.Column="1" Text="快捷操作" Style="{StaticResource Cf.SectionTitle}"
                                       Margin="8,0,0,0" />
                        </Grid>
                        <!-- 窄窗口下按钮 3+1 折行，避免「查看全部虚拟机」被挤压 -->
                        <WrapPanel>
                            <Button Style="{StaticResource Cf.SecondaryButton}" Width="110" Margin="0,0,10,0" Padding="8,12"
                                    Command="{Binding QuickCreateVmCommand}">
                                <StackPanel>
                                    <ui:SymbolIcon Symbol="Add24" FontSize="18" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource Cf.PrimaryBrush}" />
                                    <TextBlock Text="创建虚拟机" FontSize="12" Margin="0,6,0,0"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Cf.SecondaryButton}" Width="110" Margin="0,0,10,0" Padding="8,12"
                                    Command="{Binding QuickViewAllVmsCommand}">
                                <StackPanel>
                                    <ui:SymbolIcon Symbol="Desktop24" FontSize="18" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource Cf.PrimaryBrush}" />
                                    <TextBlock Text="查看全部虚拟机" FontSize="12" Margin="0,6,0,0"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Cf.SecondaryButton}" Width="110" Padding="8,12"
                                    Command="{Binding QuickOpenPortCommand}">
                                <StackPanel>
                                    <ui:SymbolIcon Symbol="Globe24" FontSize="18" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource Cf.PrimaryBrush}" />
                                    <TextBlock Text="新建规则" FontSize="12" Margin="0,6,0,0"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
