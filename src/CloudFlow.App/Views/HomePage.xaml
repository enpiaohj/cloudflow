<UserControl x:Class="CloudFlow.App.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
        <StackPanel Margin="28,22,28,30" MaxWidth="1200" HorizontalAlignment="Left">

            <!-- ===== 页头 ===== -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="首页" Style="{StaticResource Cf.PageTitle}" />
                    <TextBlock Text="欢迎回来。以下是你 Azure 环境的当前概况。"
                               Style="{StaticResource Cf.Subtitle}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding TodayText}" Style="{StaticResource Cf.Subtitle}" />
                    <TextBlock Text="{Binding ScopeSubtitle}" Style="{StaticResource Cf.Muted}"
                               HorizontalAlignment="Right" Margin="0,3,0,0" />
                </StackPanel>
            </Grid>

            <!-- ===== 统计卡 ===== -->
            <UniformGrid Columns="4" Margin="0,20,0,0">

                <Border Style="{StaticResource Cf.Card}" Margin="0,0,14,0">
                    <StackPanel>
                        <Border Style="{StaticResource Cf.IconCircle}" Background="#FFE8F0FE">
                            <ui:SymbolIcon Symbol="Cloud24" FontSize="19"
                                           Foreground="{DynamicResource Cf.PrimaryBrush}" />
                        </Border>
                        <TextBlock Text="{Binding TotalVms}" Style="{StaticResource Cf.StatNumber}" Margin="0,12,0,0" />
                        <TextBlock Text="虚拟机" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Cf.TextPrimaryBrush}" Margin="0,2,0,0" />
                        <TextBlock Text="本周新增 3 台" Style="{StaticResource Cf.Muted}"
                                   Foreground="#FF137333" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Cf.Card}" Margin="0,0,14,0">
                    <StackPanel>
                        <Border Style="{StaticResource Cf.IconCircle}" Background="#FFE6F4EA">
                            <ui:SymbolIcon Symbol="Play24" FontSize="19" Foreground="#FF137333" />
                        </Border>
                        <TextBlock Text="{Binding RunningVms}" Style="{StaticResource Cf.StatNumber}" Margin="0,12,0,0" />
                        <TextBlock Text="运行中" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Cf.TextPrimaryBrush}" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding RunningPercent}" Style="{StaticResource Cf.Muted}" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Cf.Card}" Margin="0,0,14,0">
                    <StackPanel>
                        <Border Style="{StaticResource Cf.IconCircle}" Background="#FFEEF1F5">
                            <ui:SymbolIcon Symbol="DismissCircle24" FontSize="19"
                                           Foreground="{DynamicResource Cf.TextSecondaryBrush}" />
                        </Border>
                        <TextBlock Text="{Binding DeallocatedVms}" Style="{StaticResource Cf.StatNumber}" Margin="0,12,0,0" />
                        <TextBlock Text="已解除分配" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Cf.TextPrimaryBrush}" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding DeallocatedPercent}" Style="{StaticResource Cf.Muted}" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Cf.Card}">
                    <StackPanel>
                        <Border Style="{StaticResource Cf.IconCircle}" Background="#FFFEF7E0">
                            <ui:SymbolIcon Symbol="Warning24" FontSize="19" Foreground="#FFB06000" />
                        </Border>
                        <TextBlock Text="{Binding NeedAttention}" Style="{StaticResource Cf.StatNumber}" Margin="0,12,0,0" />
                        <TextBlock Text="需要关注" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Cf.TextPrimaryBrush}" Margin="0,2,0,0" />
                        <TextBlock Text="1 台意外停机" Style="{StaticResource Cf.Muted}"
                                   Foreground="#FFC5221F" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ===== Recent Operations + Attention Items ===== -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="11*" />
                    <ColumnDefinition Width="9*" />
                </Grid.ColumnDefinitions>

                <!-- Recent Operations -->
                <Border Grid.Column="0" Style="{StaticResource Cf.Card}" Margin="0,0,14,0">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="最近操作" Style="{StaticResource Cf.SectionTitle}" />
                            <Button Grid.Column="1" Content="查看全部" Command="{Binding ViewAllJobsCommand}"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    Foreground="{DynamicResource Cf.PrimaryBrush}" FontSize="12.5" />
                        </Grid>
                        <DataGrid ItemsSource="{Binding RecentOperations}" Style="{StaticResource Cf.DataGrid}"
                                  RowHeight="36">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="时间" Binding="{Binding CreatedAt, StringFormat=hh:mm tt}"
                                                    CanUserResize="False" />
                                <DataGridTextColumn Header="操作" Binding="{Binding Display}" Width="*" />
                                <DataGridTextColumn Header="资源"
                                                    Binding="{Binding ResourceId, Converter={StaticResource NullableText}}"
                                                    Width="110">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="12.5" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="状态" Width="100" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Cf.Badge}">
                                                <TextBlock Text="{Binding Status, Converter={StaticResource StatusText}}" Style="{StaticResource Cf.BadgeText}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!-- Attention Items -->
                <Border Grid.Column="1" Style="{StaticResource Cf.Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="注意项" Style="{StaticResource Cf.SectionTitle}"
                                   Margin="0,0,0,10" />
                        <ScrollViewer VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding AttentionItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,7" Cursor="Hand"
                                              MouseLeftButtonDown="AttentionItem_Click">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0" VerticalAlignment="Top">
                                                <ui:SymbolIcon FontSize="17">
                                                    <ui:SymbolIcon.Style>
                                                        <Style TargetType="ui:SymbolIcon">
                                                            <Setter Property="Symbol" Value="Info24" />
                                                            <Setter Property="Foreground" Value="{DynamicResource Cf.PrimaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Severity}" Value="Error">
                                                                    <Setter Property="Symbol" Value="ErrorCircle24" />
                                                                    <Setter Property="Foreground" Value="#FFC5221F" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                                    <Setter Property="Symbol" Value="Warning24" />
                                                                    <Setter Property="Foreground" Value="#FFB06000" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ui:SymbolIcon.Style>
                                                </ui:SymbolIcon>
                                            </Grid>
                                            <StackPanel Grid.Column="1" Margin="10,0,8,0">
                                                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Cf.PrimaryBrush}" />
                                                <TextBlock Text="{Binding Description}" FontSize="12"
                                                           Foreground="{DynamicResource Cf.TextSecondaryBrush}" Margin="0,1,0,0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Age}" Style="{StaticResource Cf.Muted}"
                                                       VerticalAlignment="Top" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ===== Cost Insight + Quick Actions ===== -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1.6*" />
                </Grid.ColumnDefinitions>

                <!-- Cost Insight（设计文档 §40；正式 Cost 模块在 P3） -->
                <Border Grid.Column="0" Style="{StaticResource Cf.Card}" Margin="0,0,14,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="DataUsage24" FontSize="16"
                                           Foreground="{DynamicResource Cf.PrimaryBrush}" />
                            <TextBlock Grid.Column="1" Text="成本洞察" Style="{StaticResource Cf.SectionTitle}"
                                       Margin="8,0,0,0" />
                        </Grid>
                        <TextBlock Text="{Binding CostAmount}" FontSize="24" FontWeight="Bold"
                                   Foreground="{DynamicResource Cf.TextPrimaryBrush}" />
                        <TextBlock Text="本月计算成本（估算）" Style="{StaticResource Cf.Muted}"
                                   Margin="0,2,0,0" />
                        <Border Background="#FFE6F4EA" CornerRadius="999" Padding="10,3"
                                HorizontalAlignment="Left" Margin="0,10,0,0">
                            <TextBlock Text="{Binding CostDelta}" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="#FF137333" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Quick Actions -->
                <Border Grid.Column="1" Style="{StaticResource Cf.Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="Flash24" FontSize="16"
                                           Foreground="{DynamicResource Cf.PrimaryBrush}" />
                            <TextBlock Grid.Column="1" Text="快捷操作" Style="{StaticResource Cf.SectionTitle}"
                                       Margin="8,0,0,0" />
                        </Grid>
                        <UniformGrid Columns="4">
                            <Button Style="{StaticResource Cf.SecondaryButton}" Margin="0,0,10,0" Padding="8,12"
                                    Command="{Binding QuickCreateVmCommand}">
                                <StackPanel>
                                    <ui:SymbolIcon Symbol="Add24" FontSize="18" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource Cf.PrimaryBrush}" />
                                    <TextBlock Text="创建虚拟机" FontSize="12" Margin="0,6,0,0"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Cf.SecondaryButton}" Margin="0,0,10,0" Padding="8,12"
                                    Command="{Binding QuickTakeSnapshotCommand}">
                                <StackPanel>
                                    <ui:SymbolIcon Symbol="Camera24" FontSize="18" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource Cf.PrimaryBrush}" />
                                    <TextBlock Text="创建快照" FontSize="12" Margin="0,6,0,0"
                                               HorizontalAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Cf.SecondaryButton}" Margin="0,0,10,0" Padding="8,12"
                                    Command="{Binding QuickViewAllVmsCommand}">
                                <StackPanel>
                                    <ui:SymbolIcon Symbol="Desktop24" FontSize="18" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource Cf.PrimaryBrush}" />
                                    <TextBlock Text="查看全部虚拟机" FontSize="12" Margin="0,6,0,0"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Cf.SecondaryButton}" Padding="8,12"
                                    Command="{Binding QuickOpenPortCommand}">
                                <StackPanel>
                                    <ui:SymbolIcon Symbol="Globe24" FontSize="18" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource Cf.PrimaryBrush}" />
                                    <TextBlock Text="打开端口" FontSize="12" Margin="0,6,0,0"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 版本标识（概念图左下角） -->
            <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                <ui:SymbolIcon Symbol="Cloud24" FontSize="14"
                               Foreground="{DynamicResource Cf.TextMutedBrush}" />
                <TextBlock Text="CloudFlow v0.1.0-dev" Style="{StaticResource Cf.Muted}" Margin="6,0,0,0" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
