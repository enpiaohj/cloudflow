<UserControl x:Class="CloudFlow.App.Views.AllResourcesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:CloudFlow.App.Controls"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">

    <UserControl.Resources>
        <!-- 与资源组页同一条理由：删除入口必须先经过"⋯"这一步，不能是行内常驻可见的红按钮。 -->
        <ContextMenu x:Key="Cf.AllResourcesRowMenu" x:Shared="False">
            <MenuItem Header="删除资源" Click="MenuDelete_Click" />
        </ContextMenu>
    </UserControl.Resources>

    <Grid Margin="28,22,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== 面包屑 + 标题（与虚拟机页同一种页头：分组 › 当前页） ===== -->
        <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="资源" Style="{StaticResource Cf.BreadcrumbText}" />
                <TextBlock Text="  ›  " Style="{StaticResource Cf.BreadcrumbText}" />
                <TextBlock Text="所有资源" Style="{StaticResource Cf.BreadcrumbCurrent}" />
            </StackPanel>
            <TextBlock Text="所有资源" Style="{StaticResource Cf.PageTitle}" />
            <TextBlock Text="查看当前 Scope 内的全部资源，可按需清理不再使用的单个资源。"
                       Style="{StaticResource Cf.Subtitle}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- ===== 操作反馈 InfoBar ===== -->
        <Border Grid.Row="1" Style="{StaticResource Cf.InfoBar}" Margin="0,14,0,0"
                Background="{Binding InfoSeverity, Converter={StaticResource StatusBg}}"
                Visibility="{Binding InfoText, Converter={StaticResource NonEmptyToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Grid.Column="0" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"
                               Symbol="{Binding InfoSeverity, Converter={StaticResource SeverityIcon}}"
                               Foreground="{Binding InfoSeverity, Converter={StaticResource StatusFg}}" />
                <TextBlock Grid.Column="1" Text="{Binding InfoText}" FontSize="12.5" VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{Binding InfoSeverity, Converter={StaticResource StatusFg}}" />
                <Button Grid.Column="2" Style="{StaticResource Cf.IconButton}" Padding="4" Width="24" Height="24"
                        Command="{Binding DismissInfoCommand}" ToolTip="关闭"
                        automation:AutomationProperties.Name="关闭这条提示">
                    <ui:SymbolIcon Symbol="Dismiss16" FontSize="12" />
                </Button>
            </Grid>
        </Border>

        <!-- ===== 工具行：按名称搜索 + 类型/资源组/区域下拉筛选 + 批量删除 + 刷新 =====
             每个下拉旁边都有一个不随选中值变化的说明性文字（"类型"/"资源组"/"区域"）——只靠
             下拉自己的"全部 XX"默认值，一旦选中了具体的值（比如选了某个资源组的名字），
             这行字就不再出现，又会分不清这个下拉是筛哪一列的；固定在旁边的文字不受选中值影响。 -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Cf.SearchField}">
                <ui:TextBox PlaceholderText="按名称搜索…"
                            Icon="{ui:SymbolIcon Search24}"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            BorderThickness="0" Background="Transparent"
                            VerticalContentAlignment="Center" FontSize="13" />
            </Border>
            <!-- 三个下拉筛选器：各自精确匹配一列，"全部"表示不筛这一列，与名称关键字按 AND 组合。 -->
            <TextBlock Grid.Column="1" Text="类型" Style="{StaticResource Cf.Muted}"
                       VerticalAlignment="Center" Margin="14,0,6,0" />
            <ComboBox Grid.Column="2" MinWidth="110" MinHeight="34" FontSize="13"
                      ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding SelectedType}"
                      automation:AutomationProperties.Name="按类型筛选" />
            <TextBlock Grid.Column="3" Text="资源组" Style="{StaticResource Cf.Muted}"
                       VerticalAlignment="Center" Margin="14,0,6,0" />
            <ComboBox Grid.Column="4" MinWidth="110" MinHeight="34" FontSize="13"
                      ItemsSource="{Binding ResourceGroupOptions}" SelectedItem="{Binding SelectedResourceGroup}"
                      automation:AutomationProperties.Name="按资源组筛选" />
            <TextBlock Grid.Column="5" Text="区域" Style="{StaticResource Cf.Muted}"
                       VerticalAlignment="Center" Margin="14,0,6,0" />
            <ComboBox Grid.Column="6" MinWidth="110" MinHeight="34" FontSize="13"
                      ItemsSource="{Binding LocationOptions}" SelectedItem="{Binding SelectedLocation}"
                      automation:AutomationProperties.Name="按区域筛选" />
            <StackPanel Grid.Column="8" Orientation="Horizontal">
                <!-- 批量删除：勾选之后才出现，理由同资源组页；虚拟机行勾不上，不会混进来。 -->
                <Button Style="{StaticResource Cf.DangerSubtleButton}" Margin="0,0,10,0"
                        Command="{Binding BatchDeleteCommand}"
                        Visibility="{Binding HasChecked, Converter={StaticResource BoolToVisibility}}"
                        ToolTip="删除勾选的资源"
                        automation:AutomationProperties.Name="删除所选资源">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Delete24" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding BatchDeleteText}" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Cf.IconButton}"
                        Command="{Binding RefreshCommand}"
                        ToolTip="重新查询资源列表"
                        automation:AutomationProperties.Name="刷新">
                    <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="15" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ===== 资源列表 ===== -->
        <Border Grid.Row="3" Style="{StaticResource Cf.Card}" Padding="6,4,6,6" Margin="0,14,0,0">
            <Grid>
                <!-- 真实踩过的坑：批量/单项删除时崩过 InvalidOperationException（某个 ItemsControl
                     与它的项源不一致，VirtualizingStackPanel.MeasureChild 里检测到）。这个页面比
                     资源组页多一样东西——搜索框对应的 CollectionView.Filter；行虚拟化下移除项目、
                     同时又有过滤视图在场，是 WPF DataGrid 一个有据可查的 ItemContainerGenerator
                     失步场景（资源组页没有搜索过滤，同样的删除代码从未在那边崩过，两次真实崩溃
                     也都点名的是这个 Grid）。关掉虚拟化直接绕开这条脆弱路径——所有资源清单量级
                     通常是几十到几百条，关闭虚拟化的渲染成本可以接受。 -->
                <DataGrid x:Name="AllResourcesGrid"
                          ItemsSource="{Binding Rows}"
                          Style="{StaticResource Cf.DataGrid}"
                          VirtualizingPanel.IsVirtualizing="False"
                          HorizontalScrollBarVisibility="Auto"
                          Visibility="{Binding HasRows, Converter={StaticResource BoolToVisibility}}">
                    <!-- 整行右键同样打开行操作菜单（虚拟机列表页已有的常规操作方式，这里补齐）。
                         虚拟机行没有删除入口——同一条理由已经用在"⋯"按钮上（虚拟机有自己专门的
                         删除流程，这里只是第二道防线），整行右键也不能绕过去，所以虚拟机行干脆
                         不挂 ContextMenu（右键没反应），跟"⋯"按钮对这类行直接隐藏保持一致。 -->
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource Cf.GridRow}">
                            <Setter Property="ContextMenu" Value="{StaticResource Cf.AllResourcesRowMenu}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsVirtualMachine}" Value="True">
                                    <Setter Property="ContextMenu" Value="{x:Null}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <!-- 批量勾选列。紧凑单元格：默认 12 的左右内边距会把 18px 的复选框挤扁。 -->
                        <DataGridTemplateColumn Width="44" MinWidth="44" CanUserResize="False"
                                                CellStyle="{StaticResource Cf.GridCellCompact}">
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader"
                                       BasedOn="{StaticResource Cf.GridColumnHeader}">
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <!-- 只作用于当前可见（未被搜索过滤）的可删除行 -->
                                    <CheckBox IsChecked="{Binding DataContext.IsAllChecked,
                                                  RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWay}"
                                              Width="18" Height="18"
                                              FontSize="14" FontWeight="Normal"
                                              Foreground="{DynamicResource Cf.TextPrimaryBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              ToolTip="全选当前列表中可删除的资源"
                                              automation:AutomationProperties.Name="全选"
                                              Click="SelectAll_Click" />
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <!-- 虚拟机行 CanDelete 为 false，复选框禁用：虚拟机有自己专门的删除流程 -->
                                    <CheckBox IsChecked="{Binding IsChecked, Mode=OneWay}"
                                              IsEnabled="{Binding CanDelete}"
                                              Width="18" Height="18"
                                              FontSize="14" FontWeight="Normal"
                                              Foreground="{DynamicResource Cf.TextPrimaryBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              automation:AutomationProperties.Name="{Binding Name, StringFormat=选择 {0}}"
                                              Click="RowCheck_Click" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!-- 名称前放类型图标：一眼能分出网卡、磁盘、虚拟网络，不必逐行读类型列 -->
                        <DataGridTemplateColumn Header="名称" Width="1.3*" MinWidth="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="26" Height="26" CornerRadius="7" Margin="0,0,10,0"
                                                Background="{DynamicResource Cf.Status.Info.Bg}">
                                            <ui:SymbolIcon Symbol="{Binding TypeSymbol}" FontSize="14"
                                                           Foreground="{DynamicResource Cf.PrimaryBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Name}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!-- 类型显示中文名，Resource Graph 的原始类型字符串放进 ToolTip -->
                        <DataGridTemplateColumn Header="类型" Width="1*" MinWidth="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TypeDisplay}" FontSize="12.5" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Type}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="资源组" Width="1*" MinWidth="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ResourceGroupName}" FontSize="12.5" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding ResourceGroupName}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="区域" Width="0.8*" MinWidth="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Location, Converter={StaticResource RegionName}}"
                                               FontSize="12.5" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Location}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="100" MinWidth="100" CanUserResize="False"
                                                CellStyle="{StaticResource Cf.GridCellCompact}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <!-- 虚拟机有自己专门的删除流程，这里只给跳转，不提供删除入口 -->
                                        <Button Content="查看虚拟机" Style="{StaticResource Cf.LinkButton}"
                                                Padding="6,3" FontSize="12" HorizontalAlignment="Center"
                                                Visibility="{Binding IsVirtualMachine, Converter={StaticResource BoolToVisibility}}"
                                                Command="{Binding DataContext.ViewVmCommand,
                                                                  RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource Cf.TopBarButton}"
                                                Width="26" Height="26" Padding="0"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                IsEnabled="{Binding CanDelete}"
                                                Visibility="{Binding IsVirtualMachine, Converter={StaticResource InverseBoolToVisibility}}"
                                                ToolTip="更多操作" automation:AutomationProperties.Name="更多操作"
                                                Tag="{Binding}" Click="RowMenu_Click">
                                            <ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="15" />
                                            <Button.ContextMenu>
                                                <StaticResource ResourceKey="Cf.AllResourcesRowMenu" />
                                            </Button.ContextMenu>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- 关键字一项都没匹配上：表头还在，给一句说明而不是一片空白 -->
                <controls:EmptyState Margin="0,48,0,24" VerticalAlignment="Top"
                                     Symbol="Search24" Title="未找到匹配的资源"
                                     Description="可以换个关键字，或调整类型/资源组/区域筛选器。"
                                     Visibility="{Binding IsFilteredEmpty, Converter={StaticResource BoolToVisibility}}" />

                <!-- 真的没有资源（且不在加载中）：加载期间列表也是空的，不能先闪一下"没有资源" -->
                <controls:EmptyState Margin="0,24" Symbol="BoxMultiple24" Title="没有资源"
                                     Description="{Binding EmptyText}">
                    <controls:EmptyState.Style>
                        <Style TargetType="controls:EmptyState">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasRows}" Value="False" />
                                        <Condition Binding="{Binding IsLoading}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </controls:EmptyState.Style>
                </controls:EmptyState>

                <!-- 加载骨架：逐个资源组查询 Resource Graph 需要几秒，没有占位时整张卡片是空的 -->
                <Border Background="{DynamicResource Cf.LoadingScrimBrush}" CornerRadius="10"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Margin="24,18" VerticalAlignment="Center">
                        <Rectangle Style="{StaticResource Cf.SkeletonBar}" Width="420" />
                        <Rectangle Style="{StaticResource Cf.SkeletonBar}" Width="360" Margin="0,10,0,0" />
                        <Rectangle Style="{StaticResource Cf.SkeletonBar}" Width="300" Margin="0,10,0,0" />
                        <TextBlock Text="正在查询各资源组内的资源…" Style="{StaticResource Cf.Muted}" Margin="0,16,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <TextBlock Grid.Row="4" Text="{Binding SummaryText}" Style="{StaticResource Cf.Muted}" Margin="4,12,0,0"
                   Visibility="{Binding HasRows, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</UserControl>
