<themes:CfDialogWindow x:Class="CloudFlow.App.Views.SshCredentialDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:themes="clr-namespace:CloudFlow.App.Themes"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:CloudFlow.App.Controls"
        Title="SSH 连接凭据"
        Width="480" Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        Background="{DynamicResource Cf.DialogBackgroundBrush}"
        TextElement.Foreground="{DynamicResource Cf.TextPrimaryBrush}">

    <!-- 固定高度 + 内部滚动，刻意不用 SizeToContent="Height"：
         内容最高的一屏（临时输入 + 私钥文件 + 勾选存入凭据库）在小屏上会把底部按钮行挤出窗口。
         SizeToContent 只保证"窗口够高"，不保证"高得下" —— 主窗口最小高度只有 620。 -->
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── 头部：目标主机 ──
             Symbol 由代码后置从 SymbolRegular 赋值 —— XAML 里的 Symbol 字面量编译器不校验，
             写错要等首次布局才抛 XamlParseException（实测＝启动即崩），C# 侧则是编译期检查。 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <ui:SymbolIcon x:Name="TargetIcon" FontSize="20" VerticalAlignment="Center"
                           Foreground="{DynamicResource Cf.TextSecondaryBrush}" />
            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="TargetText" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource Cf.TextPrimaryBrush}" />
                <TextBlock Text="会话将在窗口底部的终端面板里打开"
                           Style="{StaticResource Cf.Muted}" FontSize="11" Margin="0,1,0,0" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,14,0,0"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <TextBlock Text="从凭据库选一条直接连接，也可以临时输入。临时输入的密码只在本机内存里存活到断开为止。"
                           Style="{StaticResource Cf.Muted}" TextWrapping="Wrap" />

                <!-- ── 使用凭据 ── 标签左、输入右，比"标签堆在输入框上方"省一半纵向空间 -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="使用凭据"
                               Style="{StaticResource Cf.Muted}" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="CredentialBox"
                              FontSize="13" MinHeight="34"
                              SelectionChanged="CredentialBox_SelectionChanged" />

                    <!-- 凭据库读不出来（文件损坏 / 由更高版本写入）时的一句话说明。
                         此时下拉里只剩「临时输入」，连接能力不受影响。 -->
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="LibraryMessage"
                               Style="{StaticResource Cf.Muted}" FontSize="11" Margin="0,4,0,0"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                </Grid>

                <!-- 选中已有凭据：只读摘要。密码与私钥正文永不回填任何控件。 -->
                <Border x:Name="SummaryPanel" CornerRadius="8" Padding="12,8" Margin="0,12,0,0"
                        Background="{DynamicResource Cf.Status.Info.Bg}" Visibility="Collapsed">
                    <TextBlock x:Name="SummaryText" FontSize="12.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource Cf.TextPrimaryBrush}" />
                </Border>

                <!-- ── 临时输入：选中「新建 / 临时输入…」时才展开 ── -->
                <StackPanel x:Name="InputPanel" Visibility="Collapsed">

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="用户名"
                                   Style="{StaticResource Cf.Muted}" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" x:Name="UsernameBox" FontSize="13" Padding="8,6"
                                 Text="azureuser" />
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="认证方式"
                                   Style="{StaticResource Cf.Muted}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" x:Name="AuthTypeBox" FontSize="13" MinHeight="34"
                                  Width="180" HorizontalAlignment="Left"
                                  SelectionChanged="AuthTypeBox_SelectionChanged">
                            <ComboBoxItem Content="密码" />
                            <ComboBoxItem Content="私钥文件" />
                        </ComboBox>
                    </Grid>

                    <!-- 这个对话框只做"连一次"，不编辑已保存的凭据 ——
                         所以没有"已保存的密码"可清除、私钥也总是当场读文件，
                         不搬 CredentialEditorDialog 那套 SecretHint / ClearXxxBox / KeyHint。 -->
                    <StackPanel x:Name="PasswordPanel" Visibility="Collapsed">
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="密码"
                                       Style="{StaticResource Cf.Muted}" VerticalAlignment="Center" />
                            <PasswordBox Grid.Column="1" x:Name="SecretBox"
                                         FontSize="13" Padding="8,6" />
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="PrivateKeyPanel">
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="私钥文件"
                                       Style="{StaticResource Cf.Muted}" VerticalAlignment="Center" />
                            <Grid Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="KeyPathBox" FontSize="12.5" Padding="8,6" />
                                <Button Grid.Column="1" Content="浏览…" Margin="8,0,0,0" Padding="10,6"
                                        Click="BrowseKey_Click" />
                            </Grid>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="私钥密码"
                                       Style="{StaticResource Cf.Muted}" VerticalAlignment="Center" />
                            <PasswordBox Grid.Row="0" Grid.Column="1" x:Name="PassphraseBox"
                                         FontSize="13" Padding="8,6" />

                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Cf.Muted}"
                                       FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="即 Passphrase，没有则留空。" />
                        </Grid>
                    </StackPanel>

                    <CheckBox x:Name="SaveCredentialBox" Content="存入凭据库（以后连接可直接复用）"
                              FontSize="12.5" Margin="0,16,0,0" IsChecked="False"
                              Checked="SaveCredentialBox_Changed" Unchecked="SaveCredentialBox_Changed" />

                    <StackPanel x:Name="NamePanel" Visibility="Collapsed">
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="凭据名称"
                                       Style="{StaticResource Cf.Muted}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameBox"
                                     FontSize="13" Padding="8,6" />

                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Cf.Muted}"
                                       FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="名称不可重复（忽略大小写）。凭据不绑定主机，之后可用于任意虚拟机。" />
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <!-- 校验错误就地显示：弹 MessageBox 会把刚填的一屏输入挡在后面，
                     而 MessageBox 还是系统对话框，不跟随应用主题。 -->
                <controls:InlineMessageBanner x:Name="ErrorBanner" Margin="0,14,0,4" SeverityKey="Failed" />
            </StackPanel>
        </ScrollViewer>

        <!-- ── 按钮行 ──
             取消走 IsCancel（Esc 与点击是同一个机制），连接走 IsDefault（回车）。
             与其它的四个对话框（OpenPort / ChangePort / Resize / ImpactApproval）保持一致。 -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="取消" Style="{StaticResource Cf.SecondaryButton}" Padding="14,6" Margin="0,0,10,0" IsCancel="True" />
                <Button Content="连接" Style="{StaticResource Cf.PrimaryButton}" Padding="14,6"
                        IsDefault="True" Click="Connect_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</themes:CfDialogWindow>
