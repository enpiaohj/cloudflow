<themes:CfDialogWindow x:Class="CloudFlow.App.Views.HostKeyConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:themes="clr-namespace:CloudFlow.App.Themes"
        Title="确认主机密钥"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        Background="{DynamicResource Cf.DialogBackgroundBrush}"
        TextElement.Foreground="{DynamicResource Cf.TextPrimaryBrush}">

    <StackPanel Margin="24,20">

        <TextBlock Text="确认主机密钥" FontSize="18" FontWeight="SemiBold"
                   Foreground="{DynamicResource Cf.TextPrimaryBrush}" />

        <!-- 指纹变化强警告 -->
        <Border x:Name="MismatchPanel" CornerRadius="6" Padding="12,8" Margin="0,10,0,0"
                Background="{DynamicResource Cf.Surface.DangerBrush}" Visibility="Collapsed">
            <TextBlock FontSize="12.5" TextWrapping="Wrap" FontWeight="SemiBold"
                       Foreground="{DynamicResource Cf.Status.Danger.Fg}"
                       Text="该主机的主机密钥与已记录的不一致！这可能意味着服务器重装，也可能存在中间人攻击风险。请谨慎确认。" />
        </Border>

        <TextBlock x:Name="IntroText" Style="{StaticResource Cf.Muted}" Margin="0,10,0,0"
                   TextWrapping="Wrap" />

        <Border CornerRadius="6" Padding="12,10" Margin="0,10,0,0"
                Background="{DynamicResource Cf.PageBackgroundBrush}">
            <StackPanel>
                <TextBlock Style="{StaticResource Cf.Muted}" Text="主机" />
                <TextBlock x:Name="HostText" FontFamily="Consolas" FontSize="13" Margin="0,2,0,0"
                           Foreground="{DynamicResource Cf.TextPrimaryBrush}" />
                <TextBlock Style="{StaticResource Cf.Muted}" Margin="0,10,0,0" Text="密钥算法" />
                <TextBlock x:Name="AlgorithmText" FontFamily="Consolas" FontSize="13" Margin="0,2,0,0"
                           Foreground="{DynamicResource Cf.TextPrimaryBrush}" />
                <TextBlock Style="{StaticResource Cf.Muted}" Margin="0,10,0,0" Text="SHA256 指纹" />
                <TextBlock x:Name="FingerprintText" FontFamily="Consolas" FontSize="13" Margin="0,2,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource Cf.TextPrimaryBrush}" />
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource Cf.Muted}" Margin="0,12,0,0" TextWrapping="Wrap"
                   Text="信任后指纹将记录在本机，后续连接不再询问；若下次连接时指纹变化，将再次弹出强警告。" />

        <!-- 回车与 Esc 都落在「取消」上，刻意不给「信任并连接」设 IsDefault：
             指纹确认是一次安全决策，误碰回车就信任新主机是不可接受的默认行为，
             与 BatchHostKeyConfirmDialog 的处理方式一致。 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Style="{StaticResource Cf.SecondaryButton}" Padding="14,6" Margin="0,0,10,0"
                    IsCancel="True" IsDefault="True" Click="Cancel_Click" />
            <Button x:Name="TrustButton" Content="信任并连接"
                    Style="{StaticResource Cf.PrimaryButton}" Padding="14,6" Click="Trust_Click" />
        </StackPanel>
    </StackPanel>
</themes:CfDialogWindow>
