<themes:CfDialogWindow x:Class="CloudFlow.App.Views.ImpactApprovalDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:themes="clr-namespace:CloudFlow.App.Themes"
        Title="影响分析"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        Background="{DynamicResource Cf.DialogBackgroundBrush}"
        TextElement.Foreground="{DynamicResource Cf.TextPrimaryBrush}">
    <!--
      上面这一行不是装饰：这是一个光秃秃的 Window，没有 WPF-UI 的控件主题，
      而 TextBlock 的默认前景是**黑色**。深色主题下背景是深色的，
      凡是没写 Foreground 的 TextBlock（本文件里的只读值框就是一例）会直接看不见。
      TextElement.Foreground 是继承属性，在这一层设一次即可覆盖全部后代。
    -->

    <StackPanel Margin="28,24">

        <TextBlock Text="影响分析" FontFamily="{DynamicResource Cf.FontFamily.Display}"
                   FontSize="18" FontWeight="SemiBold"
                   Foreground="{DynamicResource Cf.TextPrimaryBrush}" />
        <TextBlock Text="该操作会影响其他资源，请确认后再继续。" FontSize="13"
                   Foreground="{DynamicResource Cf.TextSecondaryBrush}" Margin="0,6,0,16" />

        <!-- 操作 -->
        <TextBlock Text="操作" Style="{StaticResource Cf.Muted}" />
        <Border Background="{DynamicResource Cf.PageBackgroundBrush}" CornerRadius="8"
                Padding="10,8" Margin="0,4,0,0">
            <TextBlock Text="{Binding OperationText}" FontSize="13" TextWrapping="Wrap" />
        </Border>

        <!-- 目标资源（Azure Resource ID 是唯一主键）。批量时每行一个；
             限高滚动，否则一次勾选十几项会把对话框撑出屏幕、按钮落到屏幕外。
             用醒目的危险色高亮：这是整个对话框里唯一要点确认的问题——"是不是这个东西"，
             原来跟"操作"说明用同一种低调的中性灰底、小字号，容易被一扫而过。 -->
        <TextBlock Text="{Binding TargetLabel}" Style="{StaticResource Cf.Muted}" Margin="0,12,0,0" />
        <Border Background="{DynamicResource Cf.Surface.DangerBrush}"
                BorderBrush="{DynamicResource Cf.Surface.DangerBorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="12,9" Margin="0,4,0,0">
            <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding ResourceId}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                           Foreground="{DynamicResource Cf.DangerTextBrush}" />
            </ScrollViewer>
        </Border>

        <!-- 影响面 -->
        <TextBlock Text="影响面" Style="{StaticResource Cf.Muted}" Margin="0,12,0,0" />
        <Border Background="{DynamicResource Cf.Surface.WarningBrush}" BorderBrush="{DynamicResource Cf.Surface.WarningBorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="12,9" Margin="0,4,0,0">
            <StackPanel>
                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding ImpactText}" FontSize="12.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource Cf.WarningStrongTextBrush}" />
                </ScrollViewer>
                <TextBlock Text="{Binding AffectedText}" FontSize="12" Margin="0,6,0,0"
                           Foreground="{DynamicResource Cf.WarningStrongTextBrush}"
                           Visibility="{Binding AffectedText, Converter={StaticResource NonEmptyToVisibility}}" />
            </StackPanel>
        </Border>

        <TextBlock Text="{Binding CancelHint}"
                   Style="{StaticResource Cf.Muted}" FontSize="11" Margin="0,8,0,0"
                   TextWrapping="Wrap" />

        <!-- 破坏半径更大的操作（如删除资源组、批量删除）额外要求输入确认文本才能继续 -->
        <StackPanel Visibility="{Binding RequiresConfirmText, Converter={StaticResource BoolToVisibility}}"
                    Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding ConfirmHint}" Style="{StaticResource Cf.Muted}"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
                <!-- 名称本身可能很长/含随机后缀，手动照抄容易打错——提供"复制"到剪贴板，
                     仍要求用户主动粘贴+看一眼再继续，不是"点一下就自动填好绕过确认"。 -->
                <Button Grid.Column="1" Content="复制" Style="{StaticResource Cf.SecondaryButton}"
                        Padding="10,3" FontSize="12" Margin="8,0,0,0"
                        Click="CopyConfirmText_Click" ToolTip="复制到剪贴板" />
            </Grid>
            <TextBox x:Name="ConfirmTextBox" Height="32" Margin="0,4,0,0"
                     TextChanged="ConfirmTextBox_Changed" />
        </StackPanel>

        <ProgressBar x:Name="SubmittingBar" Height="2" Margin="0,14,0,0"
                     IsIndeterminate="True" Visibility="Collapsed" />
        <Border x:Name="SubmittingPanel" CornerRadius="8" Padding="10,6" Margin="0,10,0,0"
                Background="{DynamicResource Cf.PageBackgroundBrush}" Visibility="Collapsed">
            <TextBlock x:Name="SubmittingText" Style="{StaticResource Cf.Muted}"
                       FontSize="11.5" TextWrapping="Wrap" />
        </Border>
        <Border x:Name="ErrorPanel" CornerRadius="8" Padding="10,6" Margin="0,10,0,0"
                Background="{DynamicResource Cf.Status.Danger.Bg}" Visibility="Collapsed">
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Cf.Status.Danger.Fg}"
                       FontSize="11.5" TextWrapping="Wrap" />
        </Border>

        <!-- 按钮 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,4">
            <Button x:Name="CancelButton" Content="取消" Style="{StaticResource Cf.SecondaryButton}"
                    IsCancel="True" Click="Cancel_Click" />
            <Button x:Name="ContinueButton" Content="继续" Style="{StaticResource Cf.PrimaryButton}"
                    Margin="10,0,0,0" IsDefault="True" Click="Continue_Click" />
        </StackPanel>
    </StackPanel>
</themes:CfDialogWindow>
