<themes:CfDialogWindow x:Class="CloudFlow.App.Views.ResizeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:themes="clr-namespace:CloudFlow.App.Themes"
        Title="更改虚拟机规格"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        Background="{DynamicResource Cf.DialogBackgroundBrush}"
        TextElement.Foreground="{DynamicResource Cf.TextPrimaryBrush}">
    <!--
      上面这一行不是装饰：这是一个光秃秃的 Window，没有 WPF-UI 的控件主题，
      而 TextBlock 的默认前景是**黑色**。深色主题下背景是深色的，
      凡是没写 Foreground 的 TextBlock（本文件里的只读值框就是一例）会直接看不见。
      TextElement.Foreground 是继承属性，在这一层设一次即可覆盖全部后代。
    -->

    <StackPanel Margin="24,20">

        <TextBlock Text="更改虚拟机规格" FontSize="18" FontWeight="SemiBold"
                   Foreground="{DynamicResource Cf.TextPrimaryBrush}" />
        <TextBlock Text="更换虚拟机的 VM 规格（需要重启才能完全生效）。"
                   Style="{StaticResource Cf.Muted}" Margin="0,4,0,14" />

        <TextBlock Text="当前规格" Style="{StaticResource Cf.Muted}" />
        <Border Background="{DynamicResource Cf.PageBackgroundBrush}" CornerRadius="6"
                Padding="10,7" Margin="0,4,0,0">
            <TextBlock Text="{Binding CurrentSize}" FontSize="13" />
        </Border>

        <TextBlock Text="目标规格" Style="{StaticResource Cf.Muted}" Margin="0,14,0,0" />
        <ComboBox FontSize="13" Margin="0,4,0,0"
                  ItemsSource="{Binding SizeOptions}"
                  SelectedItem="{Binding SelectedSize}" />

        <TextBlock Text="注意：Resize 会短暂重启虚拟机；不同规格计费不同。"
                   FontSize="11.5" Foreground="{DynamicResource Cf.WarningTextBrush}" Margin="0,12,0,0" TextWrapping="Wrap" />

        <TextBlock Text="{Binding ErrorText}" FontSize="11.5" Foreground="{DynamicResource Cf.ErrorTextBrush}" Margin="0,10,0,0"
                   TextWrapping="Wrap"
                   Visibility="{Binding ErrorText, Converter={StaticResource NonEmptyToVisibility}}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,4">
            <Button Content="取消" Style="{StaticResource Cf.SecondaryButton}" IsCancel="True" Click="Cancel_Click" />
            <Button Content="更改规格" Style="{StaticResource Cf.PrimaryButton}"
                    Margin="10,0,0,0" IsDefault="True" Click="Ok_Click" />
        </StackPanel>
    </StackPanel>
</themes:CfDialogWindow>
