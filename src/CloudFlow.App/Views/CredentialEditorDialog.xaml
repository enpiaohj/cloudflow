<themes:CfDialogWindow x:Class="CloudFlow.App.Views.CredentialEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:themes="clr-namespace:CloudFlow.App.Themes"
        xmlns:controls="clr-namespace:CloudFlow.App.Controls"
        Title="凭据"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        Background="{DynamicResource Cf.DialogBackgroundBrush}"
        TextElement.Foreground="{DynamicResource Cf.TextPrimaryBrush}">

    <StackPanel Margin="24,20">

        <TextBlock x:Name="HeadingText" Text="新建凭据" FontSize="18" FontWeight="SemiBold"
                   Foreground="{DynamicResource Cf.TextPrimaryBrush}" />
        <TextBlock Style="{StaticResource Cf.Muted}" Margin="0,4,0,14" TextWrapping="Wrap"
                   Text="密码或私钥以 Windows 当前用户加密（DPAPI）存放在本机保险库，其他 Windows 账户与其他机器无法解密。凭据不绑定主机，可用于任意虚拟机。" />

        <TextBlock Text="名称" Style="{StaticResource Cf.Muted}" />
        <TextBox x:Name="NameBox" FontSize="13" Padding="8,6" Margin="0,4,0,0" />
        <TextBlock Style="{StaticResource Cf.Muted}" Margin="0,3,0,0" TextWrapping="Wrap"
                   Text="仅用于在列表与连接下拉里辨认这条凭据。名称不可重复（忽略大小写）。" />

        <TextBlock Text="用户名" Style="{StaticResource Cf.Muted}" Margin="0,12,0,0" />
        <TextBox x:Name="UsernameBox" FontSize="13" Padding="8,6" Margin="0,4,0,0" Text="azureuser" />

        <TextBlock Text="认证方式" Style="{StaticResource Cf.Muted}" Margin="0,12,0,0" />
        <ComboBox x:Name="AuthTypeBox" FontSize="13" MinHeight="34" Margin="0,4,0,0"
                  Width="180" HorizontalAlignment="Left"
                  SelectionChanged="AuthTypeBox_SelectionChanged">
            <ComboBoxItem Content="密码" />
            <ComboBoxItem Content="私钥文件" />
        </ComboBox>

        <!-- 两个秘密槽位各占一个面板：密码方式用 SecretBox，私钥方式用 PassphraseBox。
             它们是不同的槽位（密码 / passphrase），共用一个输入框只会让"我现在填的到底是哪个"
             变成需要看标签才知道的事，而切换认证方式时隐藏值还会串味。 -->
        <StackPanel x:Name="PasswordPanel" Visibility="Collapsed">
            <TextBlock Text="密码" Style="{StaticResource Cf.Muted}" Margin="0,12,0,0" />
            <PasswordBox x:Name="SecretBox" FontSize="13" Padding="8,6" Margin="0,4,0,0" />
            <TextBlock x:Name="SecretHint" Style="{StaticResource Cf.Muted}" Margin="0,3,0,0"
                       TextWrapping="Wrap" Visibility="Collapsed" />
            <CheckBox x:Name="ClearSecretBox" Content="清除已保存的密码" FontSize="12.5"
                      Margin="0,8,0,0" Visibility="Collapsed" />
        </StackPanel>

        <StackPanel x:Name="PrivateKeyPanel">
            <TextBlock Text="私钥文件" Style="{StaticResource Cf.Muted}" Margin="0,12,0,0" />
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="KeyPathBox" FontSize="12.5" Padding="8,6"
                         TextChanged="KeyPathBox_TextChanged" />
                <Button Grid.Column="1" Content="浏览…" Margin="8,0,0,0" Padding="10,6"
                        Click="BrowseKey_Click" />
            </Grid>
            <!-- 私钥正文在保存时才从文件读入并加密。这行必须如实说明本次保存
                 到底会不会替换保险库里的私钥 —— 悄悄沿用旧密钥是最难排查的一类问题。 -->
            <TextBlock x:Name="KeyHint" Style="{StaticResource Cf.Muted}" Margin="0,3,0,0"
                       TextWrapping="Wrap" Visibility="Collapsed" />

            <TextBlock Text="私钥密码（Passphrase，没有则留空）" Style="{StaticResource Cf.Muted}"
                       Margin="0,10,0,0" />
            <PasswordBox x:Name="PassphraseBox" FontSize="13" Padding="8,6" Margin="0,4,0,0" />
            <CheckBox x:Name="ClearPassphraseBox" Content="清除已保存的私钥密码" FontSize="12.5"
                      Margin="0,8,0,0" Visibility="Collapsed" />
        </StackPanel>

        <TextBlock Text="备注（可选，明文保存在本机，请勿写入密码）" Style="{StaticResource Cf.Muted}"
                   Margin="0,12,0,0" />
        <TextBox x:Name="DescriptionBox" FontSize="13" Padding="8,6" Margin="0,4,0,0"
                 TextWrapping="Wrap" AcceptsReturn="False" />

        <!-- 校验错误就地显示：弹 MessageBox 会把刚填的一屏输入挡在后面，
             而错误往往只需要改其中一个字段。 -->
        <controls:InlineMessageBanner x:Name="ErrorBanner" Margin="0,14,0,0" SeverityKey="Failed" />

        <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="取消" Style="{StaticResource Cf.SecondaryButton}" Padding="14,6"
                        Margin="0,0,10,0" IsCancel="True" Click="Cancel_Click" />
                <Button Content="保存" Style="{StaticResource Cf.PrimaryButton}" Padding="14,6"
                        IsDefault="True" Click="Save_Click" />
            </StackPanel>
        </Grid>
    </StackPanel>
</themes:CfDialogWindow>
