<UserControl x:Class="CloudFlow.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,22,28,30" MaxWidth="860" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource Cf.PageTitle}" />
            <TextBlock Text="Accounts, Azure configuration and application info."
                       Style="{StaticResource Cf.Subtitle}" Margin="0,4,0,0" />

            <!-- ===== Accounts（设计文档 §6 Account Management） ===== -->
            <Border Style="{StaticResource Cf.Card}" Margin="0,20,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Accounts" Style="{StaticResource Cf.SectionTitle}" />
                        <Button Grid.Column="1" Style="{StaticResource Cf.PrimaryButton}" Padding="12,6"
                                Command="{Binding SignInCommand}"
                                Content="{Binding SignInButtonText}" />
                    </Grid>
                    <TextBlock Text="{Binding SignedInAs}" Style="{StaticResource Cf.Subtitle}" Margin="0,2,0,0" />
                    <Border CornerRadius="6" Padding="12,8" Margin="0,10,0,0"
                            Background="{Binding MessageSeverity, Converter={StaticResource StatusBg}}"
                            Visibility="{Binding MessageText, Converter={StaticResource NonEmptyToVisibility}}">
                        <TextBlock Text="{Binding MessageText}" FontSize="12.5"
                                   Foreground="{Binding MessageSeverity, Converter={StaticResource StatusFg}}" />
                    </Border>
                    <TextBlock Style="{StaticResource Cf.Muted}" Margin="0,8,0,0"
                               Text="多账号管理（Account Switcher / Add / Remove / Tenant 切换）在 P1.5 实现（设计文档 §76）。CloudFlow 不保存 Microsoft 账户密码。" />
                </StackPanel>
            </Border>

            <!-- ===== Azure Configuration ===== -->
            <Border Style="{StaticResource Cf.Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Azure Configuration" Style="{StaticResource Cf.SectionTitle}" Margin="0,0,0,10" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32" />
                            <RowDefinition Height="32" />
                            <RowDefinition Height="32" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Status" Style="{StaticResource Cf.Subtitle}" />
                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Cf.Badge}">
                            <TextBlock Text="{Binding AuthStatusText}" Style="{StaticResource Cf.BadgeText}" />
                        </Border>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Client ID" Style="{StaticResource Cf.Subtitle}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ClientIdDisplay}" FontSize="13" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Tenant ID" Style="{StaticResource Cf.Subtitle}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TenantIdDisplay}" FontSize="13" />
                    </Grid>
                    <TextBlock Style="{StaticResource Cf.Muted}" Margin="0,10,0,0"
                               Text="配置文件：src/CloudFlow.App/appsettings.json（参考 appsettings.example.json；该文件不入库）。" />
                </StackPanel>
            </Border>

            <!-- ===== Saved Scopes ===== -->
            <Border Style="{StaticResource Cf.Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Saved Scopes" Style="{StaticResource Cf.SectionTitle}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding SavedScopeNames}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <ui:SymbolIcon Symbol="Pin24" FontSize="13"
                                                   Foreground="{DynamicResource Cf.PrimaryBrush}" />
                                    <TextBlock Text="{Binding}" FontSize="13" Margin="8,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ===== About ===== -->
            <Border Style="{StaticResource Cf.Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="About" Style="{StaticResource Cf.SectionTitle}" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding AppVersion}" FontSize="13" />
                    <TextBlock Style="{StaticResource Cf.Muted}" Margin="0,6,0,0"
                               Text="产品设计基准：docs/01-产品设计/20260912-CloudFlow 云资源智能运维平台产品设计文档 v3.0.md" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
