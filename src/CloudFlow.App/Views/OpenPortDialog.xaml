<Window x:Class="CloudFlow.App.Views.OpenPortDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Open Port"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        Background="White">

    <StackPanel Margin="24,20">

        <!-- 标题（概念图 2 右侧面板） -->
        <TextBlock Text="Open Port" FontSize="18" FontWeight="SemiBold"
                   Foreground="{DynamicResource Cf.TextPrimaryBrush}" />
        <TextBlock Text="Create a new inbound security rule."
                   Style="{StaticResource Cf.Muted}" Margin="0,4,0,14" />

        <!-- Rule Name -->
        <TextBlock Text="Rule Name" Style="{StaticResource Cf.Muted}" />
        <TextBox FontSize="13" Padding="8,6" Margin="0,4,0,0"
                 Text="{Binding RuleName, UpdateSourceTrigger=PropertyChanged}" />

        <!-- Port + Protocol -->
        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Port" Style="{StaticResource Cf.Muted}" />
                <TextBox FontSize="13" Padding="8,6" Margin="0,4,0,0"
                         Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Protocol" Style="{StaticResource Cf.Muted}" />
                <ComboBox FontSize="13" Margin="0,4,0,0"
                          ItemsSource="{Binding ProtocolOptions}"
                          SelectedItem="{Binding SelectedProtocol}" />
            </StackPanel>
        </Grid>

        <!-- Source -->
        <TextBlock Text="Source" Style="{StaticResource Cf.Muted}" Margin="0,14,0,0" />
        <ComboBox FontSize="13" Margin="0,4,0,0" IsEditable="True"
                  ItemsSource="{Binding SourceOptions}"
                  SelectedItem="{Binding SelectedSource}" />

        <!-- Priority -->
        <TextBlock Text="Priority" Style="{StaticResource Cf.Muted}" Margin="0,14,0,0" />
        <TextBox FontSize="13" Padding="8,6" Margin="0,4,0,0" MaxWidth="140" HorizontalAlignment="Left"
                 Text="{Binding PriorityText, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text="Lower numbers have higher priority (100 - 4096)."
                   Style="{StaticResource Cf.Muted}" FontSize="11" Margin="0,3,0,0" />

        <!-- Apply to -->
        <TextBlock Text="Apply to" Style="{StaticResource Cf.Muted}" Margin="0,14,0,0" />
        <ComboBox FontSize="13" Margin="0,4,0,0"
                  ItemsSource="{Binding ApplyToOptions}"
                  SelectedItem="{Binding SelectedApplyTo}" />
        <TextBlock Text="Creates a rule on the VM's NIC NSG. Subnet NSG rules affect all VMs in the subnet."
                   Style="{StaticResource Cf.Muted}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" />

        <!-- 校验错误 / 风险提示 -->
        <TextBlock Text="{Binding ErrorText}" FontSize="11.5" Foreground="#FFC5221F" Margin="0,10,0,0"
                   TextWrapping="Wrap"
                   Visibility="{Binding ErrorText, Converter={StaticResource NonEmptyToVisibility}}" />
        <TextBlock Text="注意：Source = Any 会将端口暴露给 Internet，该操作将进入审批流程。"
                   FontSize="11.5" Foreground="#FFB06000" Margin="0,8,0,0" TextWrapping="Wrap" />

        <!-- 按钮 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,4">
            <Button Content="Cancel" Style="{StaticResource Cf.SecondaryButton}" IsCancel="True"
                    Click="Cancel_Click" />
            <Button Content="Create Rule" Style="{StaticResource Cf.PrimaryButton}"
                    Margin="10,0,0,0" IsDefault="True" Click="Ok_Click" />
        </StackPanel>
    </StackPanel>
</Window>
