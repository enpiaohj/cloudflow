<UserControl x:Class="CloudFlow.App.Views.VmDetailPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid Margin="28,22,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== 面包屑 ===== -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Compute" FontSize="12.5" Foreground="{DynamicResource Cf.TextMutedBrush}" />
            <TextBlock Text="  ›  " FontSize="12.5" Foreground="{DynamicResource Cf.TextMutedBrush}" />
            <TextBlock Text="Virtual Machines" FontSize="12.5" Foreground="{DynamicResource Cf.TextMutedBrush}">
                <TextBlock.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding BackToVmsCommand}" />
                </TextBlock.InputBindings>
            </TextBlock>
            <TextBlock Text="  ›  " FontSize="12.5" Foreground="{DynamicResource Cf.TextMutedBrush}" />
            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                       Foreground="{DynamicResource Cf.PrimaryBrush}" />
        </StackPanel>

        <!-- ===== VM Header（概念图 2：名称 + 状态 + IP + 操作按钮组） ===== -->
        <Border Grid.Row="1" Style="{StaticResource Cf.Card}" Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="46" Height="46" CornerRadius="10"
                        Background="#FFE8F0FE" Margin="0,0,14,0">
                    <ui:SymbolIcon Symbol="Desktop24" FontSize="24"
                                   Foreground="{DynamicResource Cf.PrimaryBrush}" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource Cf.TextPrimaryBrush}" />
                        <Border Style="{StaticResource Cf.Badge}" Margin="12,2,0,0">
                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Cf.BadgeText}" />
                        </Border>
                    </StackPanel>
                    <TextBlock FontSize="12.5" Foreground="{DynamicResource Cf.TextSecondaryBrush}" Margin="0,4,0,0">
                        <Run Text="{Binding VmSize, Mode=OneWay}" />
                        <Run Text="  ·  " />
                        <Run Text="{Binding Region, Mode=OneWay}" />
                        <Run Text="  ·  " />
                        <Run Text="{Binding ComputerName, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>

                <!-- Public / Private IP + 复制 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <StackPanel Margin="0,0,18,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Globe24" FontSize="13"
                                           Foreground="{DynamicResource Cf.TextMutedBrush}" />
                            <TextBlock Text="Public IP" FontSize="11.5"
                                       Foreground="{DynamicResource Cf.TextMutedBrush}" Margin="5,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding PublicIp, Converter={StaticResource NullableText}}"
                                       FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Cf.TextPrimaryBrush}" />
                            <Button Content="⧉" FontSize="12" Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" Margin="6,0,0,0"
                                    Command="{Binding CopyToClipboardCommand}"
                                    CommandParameter="{Binding PublicIp}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Pin24" FontSize="13"
                                           Foreground="{DynamicResource Cf.TextMutedBrush}" />
                            <TextBlock Text="Private IP" FontSize="11.5"
                                       Foreground="{DynamicResource Cf.TextMutedBrush}" Margin="5,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding PrivateIp, Converter={StaticResource NullableText}}"
                                       FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Cf.TextPrimaryBrush}" />
                            <Button Content="⧉" FontSize="12" Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" Margin="6,0,0,0"
                                    Command="{Binding CopyToClipboardCommand}"
                                    CommandParameter="{Binding PrivateIp}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- 操作按钮组 -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Cf.PrimaryButton}" Command="{Binding ConnectCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Connect" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Cf.SecondaryButton}" Margin="8,0,0,0"
                            Command="{Binding RestartCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="13" />
                            <TextBlock Text="Restart" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Cf.DangerButton}" Margin="8,0,0,0"
                            Command="{Binding PowerOffCommand}" Content="Stop" />
                    <Button Style="{StaticResource Cf.SecondaryButton}" Margin="8,0,0,0"
                            Command="{Binding OpenPortCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Add24" FontSize="13"
                                           Foreground="{DynamicResource Cf.PrimaryBrush}" />
                            <TextBlock Text="Open Port" Margin="6,0,0,0"
                                       Foreground="{DynamicResource Cf.PrimaryBrush}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Deallocate 折叠进 More，避免按钮组过宽 -->
                <Button Grid.Column="4" Content="…" FontSize="15" FontWeight="Bold"
                        Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="6,0,0,0"
                        Foreground="{DynamicResource Cf.TextSecondaryBrush}"
                        VerticalAlignment="Center">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Stop &amp; Deallocate" Click="MenuDeallocate_Click" />
                            <Separator />
                            <MenuItem Header="Copy Resource ID" Click="MenuCopyResourceId_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </Grid>
        </Border>

        <!-- ===== 操作反馈 + 审批 ===== -->
        <Grid Grid.Row="2" Margin="0,12,0,0"
              Visibility="{Binding InfoText, Converter={StaticResource NonEmptyToVisibility}}">
            <Border CornerRadius="6" Padding="12,8"
                    Background="{Binding InfoSeverity, Converter={StaticResource StatusBg}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding InfoText}" FontSize="12.5" VerticalAlignment="Center"
                               Foreground="{Binding InfoSeverity, Converter={StaticResource StatusFg}}" />
                    <Button Content="Approve" Style="{StaticResource Cf.PrimaryButton}" Padding="10,3"
                            Margin="14,0,0,0" FontSize="12"
                            Command="{Binding ApproveCommand}"
                            Visibility="{Binding PendingApprovalJob, Converter={StaticResource NullToVisibility}}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== 标签页（概念图 2：Overview / Network / Disks / Performance / Activity） ===== -->
        <Border Grid.Row="3" Style="{StaticResource Cf.Card}" Padding="6" Margin="0,12,0,0">
            <TabControl Background="Transparent" BorderThickness="0" Padding="0">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <Setter Property="Foreground" Value="{DynamicResource Cf.TextSecondaryBrush}" />
                        <Setter Property="FontSize" Value="13" />
                        <Setter Property="Padding" Value="16,9" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="bd" Background="Transparent" BorderThickness="0,0,0,2"
                                            BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush"
                                                    Value="{DynamicResource Cf.PrimaryBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource Cf.PrimaryBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Cf.PrimaryBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.ItemContainerStyle>

                <!-- ============ Overview ============ -->
                <TabItem Header="Overview">
                    <StackPanel Margin="14,14,14,16" MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Text="Overview" Style="{StaticResource Cf.SectionTitle}" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34" />
                                <RowDefinition Height="34" />
                                <RowDefinition Height="34" />
                                <RowDefinition Height="34" />
                                <RowDefinition Height="34" />
                                <RowDefinition Height="34" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Subscription" Style="{StaticResource Cf.Subtitle}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SubscriptionName}" FontSize="13" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Resource group" Style="{StaticResource Cf.Subtitle}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ResourceGroupName}" FontSize="13" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Region" Style="{StaticResource Cf.Subtitle}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Region}" FontSize="13" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Size" Style="{StaticResource Cf.Subtitle}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding VmSize}" FontSize="13" />
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="OS type" Style="{StaticResource Cf.Subtitle}" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding OsTypeText}" FontSize="13" />
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Computer name" Style="{StaticResource Cf.Subtitle}" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ComputerName}" FontSize="13" />
                        </Grid>
                    </StackPanel>
                </TabItem>

                <!-- ============ Network（P1 核心特色） ============ -->
                <TabItem Header="Network" IsSelected="True">
                    <Grid Margin="14,14,14,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Network Summary（聚合 NIC/VNet/Subnet/NSG，设计文档 §20） -->
                        <Border Grid.Column="0" Background="{DynamicResource Cf.PageBackgroundBrush}"
                                CornerRadius="8" Padding="16" Margin="0,0,14,0"
                                VerticalAlignment="Stretch">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Grid.Column="0" Symbol="ArrowRight24" FontSize="14"
                                                   Foreground="{DynamicResource Cf.PrimaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="Network Summary" Style="{StaticResource Cf.SectionTitle}"
                                               Margin="8,0,0,0" />
                                </Grid>

                                <TextBlock Text="Public IP" Style="{StaticResource Cf.Muted}" Margin="0,8,0,1" />
                                <TextBlock Text="{Binding PublicIp, Converter={StaticResource NullableText}}" FontSize="13" />
                                <TextBlock Text="Private IP" Style="{StaticResource Cf.Muted}" Margin="0,10,0,1" />
                                <TextBlock Text="{Binding PrivateIp, Converter={StaticResource NullableText}}" FontSize="13" />
                                <TextBlock Text="Network Interface" Style="{StaticResource Cf.Muted}" Margin="0,10,0,1" />
                                <TextBlock Text="{Binding NicName}" FontSize="13" />
                                <TextBlock Text="Virtual Network" Style="{StaticResource Cf.Muted}" Margin="0,10,0,1" />
                                <TextBlock Text="{Binding VnetName}" FontSize="13" />
                                <TextBlock Text="Subnet" Style="{StaticResource Cf.Muted}" Margin="0,10,0,1" />
                                <TextBlock Text="{Binding SubnetText}" FontSize="13" />
                                <TextBlock Text="Network Security Group" Style="{StaticResource Cf.Muted}" Margin="0,10,0,1" />
                                <TextBlock Text="{Binding NsgName}" FontSize="13" />

                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Border Style="{StaticResource Cf.Badge}">
                                        <TextBlock Text="{Binding SecurityState}" Style="{StaticResource Cf.BadgeText}" />
                                    </Border>
                                    <TextBlock Text="NSG rules active" Style="{StaticResource Cf.Muted}"
                                               VerticalAlignment="Center" Margin="8,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Inbound Rules -->
                        <StackPanel Grid.Column="1">
                            <!-- Shared NSG 警告横幅（设计文档 §25） -->
                            <Border CornerRadius="6" Padding="14,10" Margin="0,0,0,12"
                                    Background="#FFFEF7E0"
                                    Visibility="{Binding IsSharedSubnetNsg, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Warning24" FontSize="16" Foreground="#FFB06000" />
                                    <StackPanel Margin="10,0,0,0">
                                        <TextBlock Text="This VM uses a shared subnet NSG" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="#FF7A4A00" />
                                        <TextBlock FontSize="12" Foreground="#FF9A6700" Margin="0,2,0,0"
                                                   Text="Rules apply at the subnet level and can affect multiple VMs in this subnet. Changes require approval." />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource Cf.PageBackgroundBrush}" CornerRadius="8" Padding="14">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource Cf.SectionTitle}"
                                                   VerticalAlignment="Center">
                                            <Run Text="Inbound Rules (" /><Run Text="{Binding InboundRules.Count, Mode=OneWay}" /><Run Text=")" />
                                        </TextBlock>
                                        <Button Grid.Column="1" Style="{StaticResource Cf.PrimaryButton}" Padding="10,5"
                                                Command="{Binding OpenPortCommand}" FontSize="12.5">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="＋" FontWeight="Bold" />
                                                <TextBlock Text="Open Port" Margin="5,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <DataGrid x:Name="RulesGrid" ItemsSource="{Binding InboundRules}"
                                              Style="{StaticResource Cf.DataGrid}" RowHeight="38">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="120">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="*">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontSize" Value="12.5" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Port" Binding="{Binding DestinationPort}" Width="70" />
                                            <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="80" />
                                            <DataGridTemplateColumn Header="Action" Width="86" CanUserResize="False">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource Cf.Badge}">
                                                            <TextBlock Text="{Binding Action}" Style="{StaticResource Cf.BadgeText}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Origin" Width="90" CanUserResize="False">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource Cf.Badge}">
                                                            <TextBlock Text="{Binding Origin}" Style="{StaticResource Cf.BadgeText}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Width="52" CanUserResize="False">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="…" FontSize="15" FontWeight="Bold"
                                                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                                Foreground="{DynamicResource Cf.TextSecondaryBrush}"
                                                                Tag="{Binding}">
                                                            <Button.ContextMenu>
                                                                <ContextMenu>
                                                                    <MenuItem Header="Change Port" Click="MenuChangePort_Click" />
                                                                    <MenuItem Header="Delete Rule" Click="MenuDeleteRule_Click" />
                                                                </ContextMenu>
                                                            </Button.ContextMenu>
                                                        </Button>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>

                            <TextBlock Margin="2,8,0,0" Style="{StaticResource Cf.Muted}">
                                <Run Text="Showing 1–" /><Run Text="{Binding InboundRules.Count, Mode=OneWay}" /><Run Text=" of " />
                                <Run Text="{Binding InboundRules.Count, Mode=OneWay}" /><Run Text=" inbound rules" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- ============ Disks ============ -->
                <TabItem Header="Disks">
                    <StackPanel Margin="14,14,14,16">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Disks" Style="{StaticResource Cf.SectionTitle}" />
                            <Button Grid.Column="1" Style="{StaticResource Cf.SecondaryButton}" Padding="10,5"
                                    FontSize="12.5" Command="{Binding TakeSnapshotCommand}" Content="Create Snapshot" />
                        </Grid>
                        <DataGrid ItemsSource="{Binding Disks}" Style="{StaticResource Cf.DataGrid}" RowHeight="40">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180" />
                                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="110" />
                                <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="100" />
                                <DataGridTextColumn Header="Tier" Binding="{Binding Tier}" Width="180" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </TabItem>

                <!-- ============ Performance（设计文档 §27） ============ -->
                <TabItem Header="Performance">
                    <StackPanel Margin="14,14,14,16">
                        <TextBlock Text="Performance" Style="{StaticResource Cf.SectionTitle}" Margin="0,0,0,10" />
                        <UniformGrid Columns="5">
                            <Border Style="{StaticResource Cf.Card}" Padding="14" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="CPU" Style="{StaticResource Cf.Muted}" />
                                    <TextBlock Text="{Binding CpuText}" FontSize="22" FontWeight="Bold" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Cf.Card}" Padding="14" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="Network In" Style="{StaticResource Cf.Muted}" />
                                    <TextBlock Text="{Binding NetworkInText}" FontSize="22" FontWeight="Bold" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Cf.Card}" Padding="14" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="Network Out" Style="{StaticResource Cf.Muted}" />
                                    <TextBlock Text="{Binding NetworkOutText}" FontSize="22" FontWeight="Bold" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Cf.Card}" Padding="14" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="Disk Read" Style="{StaticResource Cf.Muted}" />
                                    <TextBlock Text="{Binding DiskReadText}" FontSize="22" FontWeight="Bold" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Cf.Card}" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="Disk Write" Style="{StaticResource Cf.Muted}" />
                                    <TextBlock Text="{Binding DiskWriteText}" FontSize="22" FontWeight="Bold" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <TextBlock Margin="0,12,0,0" Style="{StaticResource Cf.Muted}"
                                   Text="Host-level metrics (demo data). Guest metrics unavailable —— 未启用诊断扩展时仅显示主机指标。" />
                    </StackPanel>
                </TabItem>

                <!-- ============ Activity ============ -->
                <TabItem Header="Activity">
                    <StackPanel Margin="14,14,14,16">
                        <TextBlock Text="Activity" Style="{StaticResource Cf.SectionTitle}" Margin="0,0,0,10" />
                        <DataGrid ItemsSource="{Binding ActivityJobs}" Style="{StaticResource Cf.DataGrid}" RowHeight="38">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding CreatedAt, StringFormat=MM-dd HH:mm:ss}" Width="150" />
                                <DataGridTextColumn Header="Operation" Binding="{Binding Display}" Width="*" />
                                <DataGridTemplateColumn Header="Status" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Cf.Badge}">
                                                <TextBlock Text="{Binding Status}" Style="{StaticResource Cf.BadgeText}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Result" Binding="{Binding Summary}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</UserControl>
