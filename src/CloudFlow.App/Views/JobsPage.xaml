<UserControl x:Class="CloudFlow.App.Views.JobsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:CloudFlow.App.Controls">

    <Grid Margin="28,22,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="任务" Style="{StaticResource Cf.PageTitle}" />
            <TextBlock Text="所有变更操作的执行记录。每项操作都经过校验、影响评估与结果验证，并记入审计日志。"
                       Style="{StaticResource Cf.Subtitle}" Margin="0,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0" Width="180" Height="34"
                      ToolTip="按状态筛选"
                      ItemsSource="{Binding StatusOptions}"
                      SelectedItem="{Binding StatusFilter}" />
            <Button Grid.Column="2" Style="{StaticResource Cf.IconButton}"
                    Command="{Binding RefreshCommand}"
                    ToolTip="重新读取任务列表">
                <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="15" />
            </Button>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Cf.Card}" Padding="6,4,6,6" Margin="0,14,0,0">
            <Grid>
            <DataGrid ItemsSource="{Binding Jobs}" Style="{StaticResource Cf.DataGrid}"
                      Visibility="{Binding HasJobs, Converter={StaticResource BoolToVisibility}}">
                <DataGrid.Columns>
                    <!-- 固定列必须带 MinWidth：DataGrid 压缩列的下限是 MinWidth（默认 20px），
                          不设时窄窗口下会把列压碎（风险徽章被裁成空圆）而不出横向滚动条 -->
                    <DataGridTextColumn Header="时间" Binding="{Binding Job.CreatedAt, StringFormat=MM-dd HH:mm:ss}" Width="160" MinWidth="160" />
                    <!-- 无账户上下文（Demo Job）时显示 "—"，空单元格会被误读为界面缺列 -->
                    <DataGridTextColumn Header="账户"
                                        Binding="{Binding Job.AccountDisplayName, Converter={StaticResource NullableText}}"
                                        Width="140" MinWidth="140" />
                    <DataGridTextColumn Header="操作" Binding="{Binding Job.Display}" Width="0.9*" MinWidth="150" />
                    <DataGridTemplateColumn Header="状态" Width="130" MinWidth="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Cf.Badge}" DataContext="{Binding Job.Status}">
                                    <TextBlock Text="{Binding Converter={StaticResource StatusText}}"
                                               Style="{StaticResource Cf.BadgeText}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <!-- 风险徽章化：与状态列同一套 Cf.Badge，配色由 CfStatusBrushConverter.Tone 映射
                         （高=危险红、中=警告黄、低=中性灰） -->
                    <DataGridTemplateColumn Header="风险" Width="80" MinWidth="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Cf.Badge}" DataContext="{Binding Job.Risk}">
                                    <TextBlock Text="{Binding Converter={StaticResource StatusText}}"
                                               Style="{StaticResource Cf.BadgeText}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <!-- 结果：成功显示结果说明，失败显示失败原因，执行中显示子步骤（见 JobPresentation） -->
                    <DataGridTextColumn Header="结果" Binding="{Binding ResultText}" Width="1.3*" MinWidth="160">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="12.5" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Setter Property="ToolTip" Value="{Binding ResultText}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- 审批入口。放在任务中心而不是只留在详情页，是因为「等待审批」要熬得过
                         重启：重启后详情页的内联审批已经没有上下文，这里是唯一还能把 Job 推下去的地方。 -->
                    <DataGridTemplateColumn Header="" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource Cf.SecondaryButton}"
                                            Content="{Binding ApproveText}"
                                            ToolTip="{Binding ApproveHint}"
                                            IsEnabled="{Binding CanApprove}"
                                            Visibility="{Binding IsWaitingApproval, Converter={StaticResource BoolToVisibility}}"
                                            Padding="10,4" FontSize="12"
                                            Command="{Binding DataContext.ApproveCommand,
                                                              RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                    <!-- 作废：等待审批的 Job 的出口 —— 批不了的旧 Job 也能关掉，
                                         不再永久挂在列表里。 -->
                                    <Button Content="作废" Style="{StaticResource Cf.DangerSubtleButton}"
                                            ToolTip="作废此任务：不再执行，状态变为已取消并记入审计日志"
                                            Visibility="{Binding IsWaitingApproval, Converter={StaticResource BoolToVisibility}}"
                                            Padding="10,4" FontSize="12" Margin="6,0,0,0"
                                            Command="{Binding DataContext.RejectCommand,
                                                              RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

                <!-- 没有任务时不能只给空表，否则会被误读为加载失败 -->
                <controls:EmptyState Margin="0,24" Symbol="TaskListLtr24" Title="暂无任务"
                                     Description="{Binding EmptyText}"
                                     Visibility="{Binding HasJobs, Converter={StaticResource InverseBoolToVisibility}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
